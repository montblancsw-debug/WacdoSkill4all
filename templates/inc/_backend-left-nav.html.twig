{# Menu latéral principal du back-office Wacdo. #}

{# Récupère le nom de la route actuellement affichée. #}
{% set currentRoute = app.request.attributes.get('_route') %}


	<nav id="sidebar" class="sidebar js-sidebar"> <div
		class="sidebar-content js-simplebar">

		{# Permet de revenir au Dashboard en cliquant sur Wacdo. #}
		<a class="sidebar-brand" href="{{ path('app_admin_dashboard') }}">

			<span class="align-middle">
				Wacdo
			</span>

		</a>


		<ul class="sidebar-nav">


			{# ================================ #}
			{# TABLEAU DE BORD                  #}
			{# ================================ #}

				<li class="sidebar-header"> Administration
			</li>


			<li class="sidebar-item
					                {% if currentRoute == 'app_admin' or currentRoute == 'app_admin_dashboard' %}
					                    active
					                {% endif %}">

				<a class="sidebar-link" href="{{ path('app_admin_dashboard') }}">

					<i class="align-middle" data-feather="sliders"></i>

					<span class="align-middle">
						Tableau de bord
					</span>

				</a>

			</li>


			{# ================================ #}
			{# GESTION DU CATALOGUE             #}
			{# ================================ #}

				<li class="sidebar-header"> Catalogue
			</li>


			<li class="sidebar-item
					                {% if currentRoute starts with 'app_admin_categorie_' %}
					                    active
					                {% endif %}">

				<a class="sidebar-link" href="{{ path('app_admin_categorie_index') }}">

					<i class="align-middle" data-feather="grid"></i>

					<span class="align-middle">
						Catégories
					</span>

				</a>

			</li>


			<li class="sidebar-item
					                {% if currentRoute starts with 'app_admin_produit_' %}
					                    active
					                {% endif %}">

				<a class="sidebar-link" href="{{ path('app_admin_produit_index') }}">

					<i class="align-middle" data-feather="package"></i>

					<span class="align-middle">
						Produits
					</span>

				</a>

			</li>


			{# ================================ #}
			{# GESTION DES COMMANDES            #}
			{# ================================ #}

				<li class="sidebar-header"> Commandes
			</li>


			<li class="sidebar-item
					                {% if currentRoute starts with 'app_admin_commande_' %}
					                    active
					                {% endif %}">

				<a class="sidebar-link" href="{{ path('app_admin_commande_index') }}">

					<i class="align-middle" data-feather="shopping-cart"></i>

					<span class="align-middle">
						Commandes
					</span>

				</a>

			</li>


			{# ================================ #}
			{# GESTION DES UTILISATEURS         #}
			{# ================================ #}

				<li class="sidebar-header"> Utilisateurs
			</li>


			<li class="sidebar-item
					                {% if currentRoute starts with 'app_admin_utilisateur_' %}
					                    active
					                {% endif %}">

				<a class="sidebar-link" href="{{ path('app_admin_utilisateur_index') }}">

					<i class="align-middle" data-feather="users"></i>

					<span class="align-middle">
						Utilisateurs
					</span>

				</a>

			</li>


		</ul>

	</div>

</nav>
