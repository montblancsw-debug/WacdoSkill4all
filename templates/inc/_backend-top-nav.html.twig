{# Barre de navigation supérieure. #}
<nav class="navbar navbar-expand navbar-light navbar-bg">

    {# Bouton permettant d'ouvrir ou fermer le menu latéral. #}
    <a class="sidebar-toggle js-sidebar-toggle">
        <i class="hamburger align-self-center"></i>
    </a>

    <div class="navbar-collapse collapse">
        <ul class="navbar-nav navbar-align">
            {% if app.user %}
                <li class="nav-item dropdown">
                    <a
                        class="nav-link dropdown-toggle d-none d-sm-inline-block"
                        href="#"
                        data-bs-toggle="dropdown"
                    >
                        <span class="text-dark">
                            {% if app.user.utilisateurPrenom %}
                                {{ app.user.utilisateurPrenom }}
                            {% endif %}
                            {{ app.user.utilisateurNom }}
                        </span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">

                        {# Affiche l'adresse email de l'utilisateur connecté. #}
                        <span class="dropdown-item-text">
                            <strong>
                                {{ app.user.utilisateurEmail }}
                            </strong>
                        </span>

                        {# Affiche le rôle de l'utilisateur connecté. #}
                        <span class="dropdown-item-text text-muted">
                            {% if app.user.utilisateurRole == 'ROLE_ADMIN' %}
                                Administrateur
                            {% elseif app.user.utilisateurRole == 'ROLE_PREPARATEUR' %}
                                Préparateur
                            {% elseif app.user.utilisateurRole == 'ROLE_ACCUEIL' %}
                                Accueil
                            {% else %}
                                Utilisateur
                            {% endif %}
                        </span>
                        <div class="dropdown-divider"></div>

                        {# Déconnecte l'utilisateur. #}
                        <a
                            class="dropdown-item"
                            href="{{ path('app_logout') }}"
                        >
                            <i
                                class="align-middle me-1"
                                data-feather="log-out"
                            ></i>
                            Déconnexion
                        </a>
                    </div>
                </li>

            {% else %}
                <li class="nav-item">
                    <a
                        class="nav-link"
                        href="{{ path('app_login') }}"
                    >
                        <i
                            class="align-middle me-1"
                            data-feather="log-in"
                        ></i>
                        Connexion
                    </a>
                </li>
            {% endif %}

        </ul>
    </div>
</nav>