{# Navigation principale du front-office Wacdo. #}

{% set currentRoute = app.request.attributes.get('_route') %}

{% set panierSession = app.session.get('panier', {}) %}
{% set panierQuantite = 0 %}

{% for quantite in panierSession %}
	{% set panierQuantite = panierQuantite + quantite %}
{% endfor %}

<nav class="navbar navbar-expand-lg bg-white border-bottom">

	<div class="container-fluid front-navbar-shell">

		{# Marque Wacdo. #}
		<a
			class="navbar-brand fw-bold"
			href="{{ path('app_front_home') }}"
		>
			Wacdo
		</a>

		{# Bouton du menu mobile. #}
		<button
			class="navbar-toggler"
			type="button"
			data-bs-toggle="collapse"
			data-bs-target="#frontNavbar"
			aria-controls="frontNavbar"
			aria-expanded="false"
			aria-label="Ouvrir la navigation"
		>
			<span class="navbar-toggler-icon"></span>
		</button>

		<div
			class="collapse navbar-collapse"
			id="frontNavbar"
		>

			{# Navigation principale à gauche. #}
			<ul class="navbar-nav me-auto mb-2 mb-lg-0">

				<li class="nav-item">
					<a
						class="nav-link
						{% if currentRoute == 'app_front_home' or currentRoute == 'app_home' %}
							active
						{% endif %}"
						href="{{ path('app_front_home') }}"
					>
						Accueil
					</a>
				</li>

				<li class="nav-item">
					<a
						class="nav-link
						{% if currentRoute starts with 'app_front_produit' %}
							active
						{% endif %}"
						href="{{ path('app_front_produit') }}"
					>
						Catalogue
					</a>
				</li>

				<li class="nav-item">
					<a
						class="nav-link
						{% if currentRoute starts with 'app_front_categorie' %}
							active
						{% endif %}"
						href="{{ path('app_front_categorie') }}"
					>
						Catégories
					</a>
				</li>

			</ul>

			{# Compte et panier à droite. #}
			<ul class="navbar-nav ms-auto align-items-lg-center front-navbar-actions">

				{{ include('inc/_account-menu.html.twig', {
					'context': 'front'
				}) }}

				<li class="nav-item">
					<a
						class="nav-link front-cart-link
						{% if currentRoute starts with 'app_front_panier' %}
							active
						{% endif %}"
						href="{{ path('app_front_panier') }}"
					>
						Panier

						<span
							id="front-panier-badge"
							class="badge rounded-pill front-cart-badge"
						>
							{{ panierQuantite }}
						</span>
					</a>
				</li>

			</ul>

		</div>

	</div>

</nav>