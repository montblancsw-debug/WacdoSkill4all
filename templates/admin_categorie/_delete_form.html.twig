{# Supprime uniquement la catégorie sélectionnée. #}
<form
	method="post" action="{{ path('app_admin_categorie_delete', {'id': categorie.id}) }}" class="d-inline-block m-0" onsubmit="return confirm('Voulez-vous vraiment supprimer la catégorie « {{ categorie.categorieNom|e('js') }} » ?');">

	{# Protège la suppression avec un token CSRF. #}
	<input
	type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">

	{# Supprime la catégorie sélectionnée. #}
	<button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
		<i class="align-middle" data-feather="trash-2"></i>
		Supprimer
	</button>
</form>
