{# Supprime la catégorie sélectionnée. #}
<form
	method="post"
	action="{{ path('app_admin_categorie_delete', {'id': categorie.id}) }}"
	class="d-inline"
	onsubmit="return confirm('Voulez-vous vraiment supprimer la catégorie « {{ categorie.categorieNom|e('js') }} » ?');"
>
	<input
		type="hidden"
		name="_token"
		value="{{ csrf_token('delete' ~ categorie.id) }}"
	>

	<button
		type="submit"
		class="btn btn-danger"
		title="Supprimer"
	>
		<i class="align-middle me-1" data-feather="trash-2"></i>
		Supprimer
	</button>
</form>