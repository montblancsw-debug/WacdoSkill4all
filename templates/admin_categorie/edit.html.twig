{% extends 'base-backend.html.twig' %}

{% block title %}
	Modifier une catégorie | Wacdo
{% endblock %}

{% block body %}

	{# Présentation de la catégorie à modifier. #}
	<div class="mb-3">
		<h1 class="h3">
			Modifier la catégorie
		</h1>

		<p class="text-muted">
			{{ categorie.categorieNom }}
		</p>
	</div>

	{# Formulaire de modification. #}
	{{ include('admin_categorie/_form.html.twig', {
		'button_label': 'Mettre à jour'
	}) }}

	{# Retour à la liste des catégories. #}
	<div class="mt-3">
		<a
			href="{{ path('app_admin_categorie_index') }}"
			class="btn btn-secondary"
		>
			<i class="align-middle" data-feather="arrow-left"></i>
			Retour à la liste
		</a>
	</div>

{% endblock %}