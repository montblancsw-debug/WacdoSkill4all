{# Modification d'une catégorie existante. #}

{% extends 'base-backend.html.twig' %}
{% block title %}
	Modifier une catégorie | Wacdo
{% endblock %}

{% block body %}
	<div class="mb-3">
		<h1 class="h3">
			Modifier la catégorie
		</h1>

		<p class="text-muted">
			{{ categorie.categorieNom }}
		</p>
	</div>

		{# Récupération du boutons d'include pour la mise à jour #}
	{{ include(
        'admin_categorie/_form.html.twig',
        {
            'button_label': 'Mettre à jour'
        }
    ) }}

		{# Bouton Retour à la liste #}
	<div class="d-flex gap-2 mt-3">
		<a href="{{ path('app_admin_categorie_index') }}" class="btn btn-secondary">
			<i class="align-middle" data-feather="arrow-left"></i>
			Retour à la liste
		</a>

		{# Include de Suppression de la catégorie sélectionnée #}
		{{ include('admin_categorie/_delete_form.html.twig') }}

	</div>
{% endblock %}
