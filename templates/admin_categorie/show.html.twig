{% extends 'base-backend.html.twig' %}

{% block title %}
	{{ categorie.categorieNom }} | Wacdo
{% endblock %}

{% block body %}
	<div class="d-flex justify-content-between align-items-center mb-3">
		<div>
			<h1 class="h3 mb-0">
				{{ categorie.categorieNom }}
			</h1>

			<p class="text-muted mb-0">
				Informations de la catégorie
			</p>
		</div>

		<a
			href="{{ path('app_admin_categorie_edit', {'id': categorie.id}) }}"
			class="btn btn-warning"
		>
			<i class="align-middle" data-feather="edit"></i>
			Modifier
		</a>
	</div>

	<div class="card">
		<div class="card-header">
			<h5 class="card-title mb-0">
				Détail de la catégorie
			</h5>
		</div>

		<div class="card-body">
			<table class="table align-middle">
				<tbody>
					<tr>
						<th style="width: 30%;">
							ID
						</th>

						<td>
							{{ categorie.id }}
						</td>
					</tr>

					<tr>
						<th>
							Nom
						</th>

						<td>
							{{ categorie.categorieNom }}
						</td>
					</tr>

					<tr>
						<th>
							Description
						</th>

						<td>
							{% if categorie.categorieDescription %}
								{{ categorie.categorieDescription|raw }}
							{% else %}
								<span class="text-muted">
									Aucune description
								</span>
							{% endif %}
						</td>
					</tr>

					<tr>
						<th>
							Nom du fichier
						</th>

						<td>
							{% if categorie.categorieNomdefichier %}
								{{ categorie.categorieNomdefichier }}
							{% else %}
								<span class="text-muted">
									Non renseigné
								</span>
							{% endif %}
						</td>
					</tr>

					<tr>
						<th>
							Image
						</th>

						<td>
							{% if categorie.categorieNomdefichier %}
								<img
									src="{{ asset('images/categories/' ~ categorie.categorieNomdefichier) }}"
									alt="{{ categorie.categorieNom }}"
									class="img-fluid rounded"
									style="max-width: 300px; max-height: 300px;"
								>
							{% else %}
								<span class="text-muted">
									Aucune image
								</span>
							{% endif %}
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<div class="mt-3">
		<a
			href="{{ path('app_admin_categorie_index') }}"
			class="btn btn-secondary"
		>
			<i class="align-middle" data-feather="arrow-left"></i>
			Retour à la liste
		</a>
	</div>
{% endblock %}