{# Création d'une nouvelle catégorie Wacdo. #}

{% extends 'base-backend.html.twig' %}
{% block title %}
	Ajouter une catégorie | Wacdo
{% endblock %}
{% block body %}

	<div class="mb-3">
		<h1 class="h3">
			Ajouter une catégorie
		</h1>
		<p class="text-muted">
			Créer une nouvelle catégorie de produits.
		</p>
	</div>

	{{ include('admin_categorie/_form.html.twig') }}
	<div class="mt-3">
		<a href="{{ path('app_admin_categorie_index') }}" class="btn btn-secondary">
			<i class="align-middle" data-feather="arrow-left"></i>
			Retour à la liste
		</a>
	</div>
{% endblock %}
