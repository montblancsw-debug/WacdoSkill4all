{# Formulaire du CRUD admin_catégorie. #}

<div class="card">

	<div class="card-header">
		<h5 class="card-title mb-0">
			Informations de la catégorie
		</h5>
	</div>

	{{ form_start(form, {
		'attr': {
			'id': 'admin-categorie-form',
			'data-live-validation': 'true'
		}
	}) }}

	<div class="card-body">

		<div class="mb-3">
			{{ form_label(form.categorie_nom) }}
			{{ form_widget(form.categorie_nom) }}
			{{ form_errors(form.categorie_nom) }}
		</div>

		<div class="mb-3">
			{{ form_label(form.categorie_description) }}
			{{ form_widget(form.categorie_description) }}
			{{ form_errors(form.categorie_description) }}
		</div>

		<div class="mb-3">

			{{ form_label(form.imageFile) }}
			{{ form_widget(form.imageFile) }}
			{{ form_errors(form.imageFile) }}

			<div class="form-text">
				Formats acceptés : JPG, PNG ou WEBP. Taille maximale : 2 Mo.
			</div>

			{% if categorie.categorieNomdefichier %}

				<div class="mt-3">

					<img
						src="{{ asset('images/categories/' ~ categorie.categorieNomdefichier) }}?v={{ categorie.updatedAt ? categorie.updatedAt|date('U') : '1' }}"
						alt="{{ categorie.categorieNom }}"
						class="wacdo-edit-image-preview"
					>

					<div class="form-text">
						Image actuelle : {{ categorie.categorieNomdefichier }}
					</div>

					<div class="form-text">
						Laissez le champ vide pour conserver cette image.
					</div>

				</div>

			{% endif %}

		</div>

	</div>

	{{ form_end(form) }}

	<div class="card-footer d-flex align-items-center gap-2">

		<button
			type="submit"
			form="admin-categorie-form"
			class="btn btn-primary"
		>
			{{ button_label|default('Enregistrer') }}
		</button>

		{% if categorie.id %}
			{{ include('admin_categorie/_delete_form.html.twig') }}
		{% endif %}

	</div>

</div>