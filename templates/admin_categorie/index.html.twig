{# Liste des catégories du back-office. #}

{% extends 'base-backend.html.twig' %}

{% block title %}
	Gestion des catégories | Wacdo
{% endblock %}

{% block body %}
	<div class="d-flex justify-content-between align-items-center mb-3">
		<div>
			<h1 class="h3 mb-0">
				Gestion des catégories
			</h1>

			<p class="text-muted mb-0">
				Liste des catégories de produits.
			</p>
		</div>
		<a href="{{ path('app_admin_categorie_new') }}" class="btn btn-primary">
			<i class="align-middle" data-feather="plus">
				
			</i>
			Ajouter une catégorie
		</a>
	</div>

	<div class="card">
		<div class="card-header">
			<h5 class="card-title mb-0">
				Catégories
			</h5>
		</div>

		<div class="card-body">
			<div class="table-responsive">
				<table class="table table-hover">
					<thead>
						{# Ouverture des TH #}
						<tr>
							<th>
								ID
							</th>

							<th>
								Nom
							</th>

							<th>
								Description
							</th>

							<th>
								Nom du fichier
							</th>

							<th>
								Image
							</th>

							<th class="text-end">
								Actions
							</th>
						{# Fermeture des TH #}
						</tr>

					</thead>
					<tbody>

						{% for categorie in categories %}
							<tr>
								<td>
									{{ categorie.id }}
								</td>

								<td>
									<strong>
										{{ categorie.categorieNom }}
									</strong>
								</td>

								<td>
									{{ categorie.categorieDescription ?: 'Aucune description' }}
								</td>

								<td>
									{{ categorie.categorieNomdefichier ?: 'Non renseigné' }}
								</td>

								<td>
									{{ categorie.categorieImage ?: 'Aucune image' }}
								</td>

								<td
									class="text-end">
									{# Consultation de la catégorie #}
									<a href="{{ path('app_admin_categorie_show', {'id': categorie.id}) }}" class="btn btn-sm btn-info" title="Voir">
										<i class="align-middle" data-feather="eye">

										</i>
										Voir
									</a>

									{# Modification de la catégorie #}
									<a href="{{ path('app_admin_categorie_edit', {'id': categorie.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
										<i class="align-middle" data-feather="edit">

										</i>
										Modifier
									</a>
								</td>
							</tr>

						{# Envoie un message si la Catégories Modifier n'as pas été mise à jours #}
						{% else %}
							<tr>
								<td colspan="6" class="text-center text-muted">
									Aucune catégorie enregistrée.
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>
{% endblock %}
