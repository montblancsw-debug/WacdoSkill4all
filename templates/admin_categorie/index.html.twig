{# Liste des catégories du back-office. #}

{% extends 'base-backend.html.twig' %}

{% block title %}
    Gestion des catégories | Wacdo
{% endblock %}

{% block body %}

    {# Affiche l'en-tête de la page. #}
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <h1 class="h3 mb-0">
                Gestion des catégories
            </h1>

            <p class="text-muted mb-0">
                Liste des catégories de produits.
            </p>

        </div>

        {# Permet d'ajouter une nouvelle catégorie. #}
        <a
            href="{{ path('app_admin_categorie_new') }}"
            class="btn btn-primary"
        >
            <i
                class="align-middle"
                data-feather="plus"
            ></i>

            Ajouter une catégorie
        </a>

    </div>

    {# Affiche la liste des catégories. #}
    <div class="card">

        <div class="card-header">

            <h5 class="card-title mb-0">
                Catégories
            </h5>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead>

                        <tr>

                            <th>
                                ID
                            </th>

                            <th>
                                Nom
                            </th>

                            <th>
                                Description
                            </th>

                            <th>
                                Nom du fichier
                            </th>

                            <th>
                                Image
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        {% for categorie in categories %}

                            <tr>

                                {# Affiche l'identifiant. #}
                                <td>
                                    {{ categorie.id }}
                                </td>

                                {# Affiche le nom de la catégorie. #}
                                <td>

                                    <strong>
                                        {{ categorie.categorieNom }}
                                    </strong>

                                </td>

                                {# Affiche la description sans les balises CKEditor. #}
                                <td>

                                    {% if categorie.categorieDescription %}

                                        {{ categorie.categorieDescription|striptags }}

                                    {% else %}

                                        <span class="text-muted">
                                            Aucune description
                                        </span>

                                    {% endif %}

                                </td>

                                {# Affiche le nom du fichier. #}
                                <td>

                                    {% if categorie.categorieNomdefichier %}

                                        {{ categorie.categorieNomdefichier }}

                                    {% else %}

                                        <span class="text-muted">
                                            Non renseigné
                                        </span>

                                    {% endif %}

                                </td>

                                {# Affiche le nom de l'image. #}
                                <td>

                                    {% if categorie.categorieImage %}

                                        {{ categorie.categorieImage }}

                                    {% else %}

                                        <span class="text-muted">
                                            Aucune image
                                        </span>

                                    {% endif %}

                                </td>

                                {# Affiche les actions du CRUD. #}
                                <td class="text-end">

                                    <a
                                        href="{{ path('app_admin_categorie_show', {'id': categorie.id}) }}"
                                        class="btn btn-sm btn-info"
                                        title="Voir"
                                    >
                                        <i
                                            class="align-middle"
                                            data-feather="eye"
                                        ></i>

                                        Voir
                                    </a>

                                    <a
                                        href="{{ path('app_admin_categorie_edit', {'id': categorie.id}) }}"
                                        class="btn btn-sm btn-warning"
                                        title="Modifier"
                                    >
                                        <i
                                            class="align-middle"
                                            data-feather="edit"
                                        ></i>

                                        Modifier
                                    </a>

                                </td>

                            </tr>

                        {% else %}

                            <tr>

                                <td
                                    colspan="6"
                                    class="text-center text-muted"
                                >
                                    Aucune catégorie enregistrée.
                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </div>

{% endblock %}