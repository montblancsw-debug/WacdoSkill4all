{% extends 'base-backend.html.twig' %}

{% block title %}
    Gestion des commandes | Wacdo
{% endblock %}

{% block body %}

    {# Affiche l'en-tête de la page. #}
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                Gestion des commandes
            </h1>

            <p class="text-muted mb-0">
                Consultez et gérez les commandes Wacdo.
            </p>
        </div>

        <a
            href="{{ path('app_admin_commande_new') }}"
            class="btn btn-primary"
        >
            Ajouter une commande
        </a>

    </div>

    {# Affiche la liste des commandes. #}
    <div class="card">

        <div class="card-header">
            <h5 class="card-title mb-0">
                Liste des commandes
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Date</th>
                            <th>Utilisateur</th>
                            <th>Statut</th>
                            <th>Articles</th>
                            <th>Total</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for commande in commandes %}

                            <tr>

                                {# Affiche le numéro de commande. #}
                                <td>
                                    <strong>
                                        #{{ commande.id }}
                                    </strong>
                                </td>

                                {# Affiche la date de la commande. #}
                                <td>
                                    {{ commande.commandeDate
                                        ? commande.commandeDate|date('d/m/Y H:i')
                                        : 'Non renseignée'
                                    }}
                                </td>

                                {# Affiche l'utilisateur associé. #}
                                <td>

                                    {% if commande.utilisateur %}

                                        {{ commande.utilisateur.utilisateurPrenom }}
                                        {{ commande.utilisateur.utilisateurNom }}

                                    {% else %}

                                        <span class="text-muted">
                                            Utilisateur supprimé
                                        </span>

                                    {% endif %}

                                </td>

                                {# Affiche le statut de la commande. #}
                                <td>

                                    {% if commande.commandeStatut == 'en attente' %}

                                        <span class="badge bg-warning">
                                            En attente
                                        </span>

                                    {% elseif commande.commandeStatut == 'préparée' %}

                                        <span class="badge bg-info">
                                            Préparée
                                        </span>

                                    {% elseif commande.commandeStatut == 'livrée' %}

                                        <span class="badge bg-success">
                                            Livrée
                                        </span>

                                    {% else %}

                                        <span class="badge bg-secondary">
                                            {{ commande.commandeStatut }}
                                        </span>

                                    {% endif %}

                                </td>

                                {# Affiche le nombre de lignes de commande. #}
                                <td>
                                    {{ commande.details|length }}
                                </td>

                                {# Affiche le montant total. #}
                                <td>
                                    <strong>
                                        {{ commande.commandeTotal|number_format(2, ',', ' ') }}
                                        €
                                    </strong>
                                </td>

                                {# Affiche les actions du CRUD. #}
                                <td class="text-end">

                                    <a
                                        href="{{ path('app_admin_commande_show', {'id': commande.id}) }}"
                                        class="btn btn-info btn-sm"
                                    >
                                        Voir
                                    </a>

                                    <a
                                        href="{{ path('app_admin_commande_edit', {'id': commande.id}) }}"
                                        class="btn btn-warning btn-sm"
                                    >
                                        Modifier
                                    </a>

                                    {{ include('admin_commande/_delete_form.html.twig') }}

                                </td>

                            </tr>

                        {% else %}

                            <tr>

                                <td
                                    colspan="7"
                                    class="text-center text-muted"
                                >
                                    Aucune commande enregistrée.
                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </div>

{% endblock %}