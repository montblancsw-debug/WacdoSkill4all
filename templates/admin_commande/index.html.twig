{% extends 'base-backend.html.twig' %}

{% block title %}
	{% if modePreparation %}
		Commandes à préparer | Wacdo
	{% else %}
		Gestion des commandes | Wacdo
	{% endif %}
{% endblock %}
{% block body %}

	{# En-tête de la page. #}
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1 class="h3 mb-1">
				{% if modePreparation %}
					Commandes à préparer
				{% else %}
					Gestion des commandes
				{% endif %}
			</h1>

			<p class="text-muted mb-0">
				{% if modePreparation %}
					Les commandes sont triées par heure de livraison croissante.
				{% else %}
					Consultez et gérez les commandes Wacdo.
				{% endif %}
			</p>
		</div>

		{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ACCUEIL') %}
			<a
				href="{{ path('app_admin_commande_new') }}"
				class="btn btn-primary"
			>
				Ajouter une commande
			</a>
		{% endif %}
	</div>

	<div class="card">
		<div class="card-header">
			<h5 class="card-title mb-0">
				{% if modePreparation %}
					Liste des commandes en attente de préparation
				{% else %}
					Liste des commandes
				{% endif %}
			</h5>

		</div>
		<div class="card-body">

			{# Recherche et tri des commandes. #}
			<form
				method="post"
				action="{{ path('app_admin_commande_index') }}"
				class="row g-2 mb-4"
			>
				<div class="col-12 col-xl">
					<input
						type="text"
						name="search"
						class="form-control"
						placeholder="Rechercher par numéro, utilisateur ou statut..."
						value="{{ search|default('') }}"
					>
				</div>

				{% if not modePreparation %}

					<div class="col-12 col-md-5 col-xl-3">
						<select
							id="commande-sort"
							class="form-select"
						>
							<option value="desc">
								Plus récentes d'abord
							</option>
							<option value="asc">
								Plus anciennes d'abord
							</option>
						</select>
					</div>

				{% else %}

					<div class="col-12 col-md-5 col-xl-3">
						<input
							type="text"
							class="form-control"
							value="Livraison : ordre croissant"
							disabled
						>
					</div>

				{% endif %}

				<div class="col-6 col-md-auto">
					<button
						type="submit"
						class="btn btn-primary w-100"
					>
						Rechercher
					</button>

				</div>
				<div class="col-6 col-md-auto">
					<a
						id="commande-reset"
						href="{{ path('app_admin_commande_index') }}"
						class="btn btn-secondary w-100"
					>
						Réinitialiser
					</a>
				</div>
			</form>

			{# Liste des commandes. #}
			<div class="table-responsive">
				<table
					id="commandes-table"
					class="table table-hover align-middle"
				>

					<thead>
						<tr>
							<th>N°</th>
							<th>Date</th>
							<th>Livraison prévue</th>
							<th>Utilisateur</th>
							<th>Statut</th>
							<th>Articles</th>
							<th>Total</th>
							<th class="text-end">Actions</th>
						</tr>

					</thead>
					<tbody id="commandes-table-body">
						{% for commande in commandes %}
							<tr
								class="commande-row"
								data-date="{{ commande.commandeDate ? commande.commandeDate|date('U') : 0 }}"
							>
								<td>
									<strong>
										#{{ commande.id }}
									</strong>
								</td>
								<td>
									{{ commande.commandeDate
										? commande.commandeDate|date('d/m/Y H:i')
										: 'Non renseignée'
									}}
								</td>
								<td>
									{% if commande.commandeHoraireLivraison %}
										<strong>
											{{ commande.commandeHoraireLivraison|date('d/m/Y H:i') }}
										</strong>
									{% else %}
										<span class="text-muted">
											Non renseignée
										</span>
									{% endif %}
								</td>
								<td>
									{% if commande.utilisateur %}
										{{ commande.utilisateur.utilisateurPrenom }}
										{{ commande.utilisateur.utilisateurNom }}
									{% else %}
										<span class="text-muted">
											Utilisateur supprimé
										</span>
									{% endif %}
								</td>
								<td>
									{% if commande.commandeStatut == 'en attente' %}
										<span class="badge bg-warning">
											En attente
										</span>
									{% elseif commande.commandeStatut == 'en préparation' %}
										<span class="badge bg-info">
											En préparation
										</span>
									{% elseif commande.commandeStatut == 'prête' %}
										<span class="badge bg-primary">
											Prête
										</span>
									{% elseif commande.commandeStatut == 'en livraison' %}
										<span class="badge bg-info">
											En livraison
										</span>
									{% elseif commande.commandeStatut == 'livrée' %}
										<span class="badge bg-success">
											Livrée
										</span>
									{% elseif commande.commandeStatut == 'annulée' %}
										<span class="badge bg-danger">
											Annulée
										</span>
									{% else %}
										<span class="badge bg-secondary">
											{{ commande.commandeStatut }}
										</span>
									{% endif %}
								</td>
								<td>
									{{ commande.details|length }}
								</td>
								<td>
									<strong>
										{{ commande.commandeTotal|number_format(2, ',', ' ') }}
										€
									</strong>
								</td>
								<td class="text-end">
									<a href="{{ path('app_admin_commande_show', {'id': commande.id}) }}" class="btn btn-info btn-sm">
										Voir
									</a>
									{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ACCUEIL') %}
										<a href="{{ path('app_admin_commande_edit', {'id': commande.id}) }}" class="btn btn-warning btn-sm">
											Modifier
										</a>
									{% endif %}
									{% if is_granted('ROLE_ADMIN') %}
										{{ include('admin_commande/_delete_form.html.twig') }}
									{% endif %}
								</td>
							</tr>

						{% else %}

							<tr>
								<td colspan="8" class="text-center text-muted">
									{% if search|default('') %}
										Aucune commande ne correspond à votre recherche.
									{% elseif modePreparation %}
										Aucune commande n'est actuellement à préparer.
									{% else %}
										Aucune commande enregistrée.
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>

{% endblock %}

{% block javascripts %}

	{% if not modePreparation %}

		<script>
			document.addEventListener(
				'DOMContentLoaded',
				function () {

					// Récupère les éléments nécessaires au tri.

					const sortSelect = document.getElementById(
						'commande-sort'
					);

					const tableBody = document.getElementById(
						'commandes-table-body'
					);

					const resetButton = document.getElementById(
						'commande-reset'
					);

					if (!sortSelect || !tableBody) {
						return;
					}

					// Récupère le dernier tri utilisé.

					const savedSort = localStorage.getItem(
						'wacdo-commande-sort'
					);

					if (
						savedSort === 'asc'
						|| savedSort === 'desc'
					) {
						sortSelect.value = savedSort;
					}

					// Trie les commandes selon leur date de création.

					function sortCommandes() {
						const rows = Array.from(
							tableBody.querySelectorAll(
								'.commande-row'
							)
						);

						const direction = sortSelect.value;

						rows.sort(
							function (
								firstRow,
								secondRow
							) {
								const firstDate = Number(
									firstRow.dataset.date || 0
								);
								const secondDate = Number(
									secondRow.dataset.date || 0
								);
								if (direction === 'asc') {
									return firstDate - secondDate;
								}
								return secondDate - firstDate;
							}
						);

						rows.forEach(
							function (row) {
								tableBody.appendChild(
									row
								);
							}
						);
					}

					// Enregistre le tri sélectionné.

					sortSelect.addEventListener(
						'change',
						function () {
							localStorage.setItem(
								'wacdo-commande-sort',
								sortSelect.value
							);
							sortCommandes();
						}
					);

					// Réinitialise le tri enregistré.

					if (resetButton) {
						resetButton.addEventListener(
							'click',
							function () {
								localStorage.removeItem(
									'wacdo-commande-sort'
								);
							}
						);
					}
					sortCommandes();
				}
			);

		</script>

	{% endif %}

{% endblock %}