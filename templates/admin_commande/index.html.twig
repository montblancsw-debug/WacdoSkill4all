{% extends 'base.html.twig' %}

{% block title %}Commande index{% endblock %}

{% block body %}
    <h1>Commande index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Commande_statut</th>
                <th>Commande_date</th>
                <th>Commande_total</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for commande in commandes %}
            <tr>
                <td>{{ commande.id }}</td>
                <td>{{ commande.commandeStatut }}</td>
                <td>{{ commande.commandeDate ? commande.commandeDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ commande.commandeTotal }}</td>
                <td>
                    <a href="{{ path('app_admin_commande_show', {'id': commande.id}) }}">show</a>
                    <a href="{{ path('app_admin_commande_edit', {'id': commande.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_admin_commande_new') }}">Create new</a>
{% endblock %}
