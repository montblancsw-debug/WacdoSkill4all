{# Affiche le formulaire de création ou de modification d'une commande. #}
<div class="card">

	<div class="card-header">
		<h5 class="card-title mb-0">
			Informations de la commande
		</h5>
	</div>

	{{ form_start(form, {
		'attr': {
			'id': 'admin-commande-form',
			'data-live-validation': 'true'
		}
	}) }}

	<div class="card-body">

		{# Statut de la commande. #}
		<div class="mb-3">
			{{ form_label(form.commande_statut) }}
			{{ form_widget(form.commande_statut) }}
			{{ form_errors(form.commande_statut) }}
		</div>

		{# Date de la commande. #}
		<div class="mb-3">
			{{ form_label(form.commande_date) }}
			{{ form_widget(form.commande_date) }}
			{{ form_errors(form.commande_date) }}
		</div>

		{# Total de la commande. #}
		<div class="mb-3">
			{{ form_label(form.commande_total) }}
			{{ form_widget(form.commande_total) }}
			{{ form_errors(form.commande_total) }}
		</div>

		{# Utilisateur associé à la commande. #}
		<div class="mb-3">
			{{ form_label(form.utilisateur) }}
			{{ form_widget(form.utilisateur) }}
			{{ form_errors(form.utilisateur) }}
		</div>

	</div>

	{{ form_end(form) }}

	<div class="card-footer d-flex align-items-center gap-2">

		<button
			type="submit"
			form="admin-commande-form"
			class="btn btn-primary"
		>
			{{ button_label|default('Enregistrer') }}
		</button>

		{% if commande.id and is_granted('ROLE_ADMIN') %}
			{{ include('admin_commande/_delete_form.html.twig') }}
		{% endif %}

	</div>

</div>