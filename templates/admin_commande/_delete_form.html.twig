{# Formulaire sécurisé de suppression. #}
<form
    method="post"
    action="{{ path('app_admin_commande_delete', {'id': commande.id}) }}"
    class="d-inline"
    onsubmit="return confirm('Voulez-vous vraiment supprimer cette commande ?');"
>

    {# Protège la suppression avec un jeton CSRF. #}
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('delete' ~ commande.id) }}"
    >

    {# Supprime uniquement la commande sélectionnée. #}
    <button class="btn btn-danger btn-sm">
        Supprimer
    </button>

</form>