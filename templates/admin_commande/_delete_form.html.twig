{# Supprime la commande sélectionnée. #}
<form
	method="post"
	action="{{ path('app_admin_commande_delete', {'id': commande.id}) }}"
	class="d-inline"
	onsubmit="return confirm('Voulez-vous vraiment supprimer cette commande ?');"
>
	<input
		type="hidden"
		name="_token"
		value="{{ csrf_token('delete' ~ commande.id) }}"
	>

	<button
		type="submit"
		class="btn btn-danger btn-sm wacdo-delete-button"
	>
		<i class="align-middle" data-feather="trash-2"></i>
		Supprimer
	</button>
</form>