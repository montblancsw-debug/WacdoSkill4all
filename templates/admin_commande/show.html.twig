{% extends 'base-backend.html.twig' %}

{% block title %}
	Commande #{{ commande.id }} | Wacdo
{% endblock %}

{% block body %}

	{# En-tête de la commande. #}
	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>
			<h1 class="h3 mb-1">
				Commande #{{ commande.id }}
			</h1>

			<p class="text-muted mb-0">
				Détail de la commande
			</p>
		</div>

		<div class="d-flex gap-2">

			{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ACCUEIL') %}
				<a
					href="{{ path('app_admin_commande_edit', {'id': commande.id}) }}"
					class="btn btn-warning"
				>
					Modifier
				</a>
			{% endif %}

			{% if is_granted('ROLE_ADMIN') %}
				{{ include('admin_commande/_delete_form.html.twig') }}
			{% endif %}

		</div>

	</div>

	{# Informations générales de la commande. #}
	<div class="card">

		<div class="card-header">
			<h5 class="card-title mb-0">
				Informations de la commande
			</h5>
		</div>

		<div class="card-body">

			<table class="table align-middle">
				<tbody>

					<tr>
						<th style="width: 250px;">
							Numéro
						</th>

						<td>
							#{{ commande.id }}
						</td>
					</tr>

					<tr>
						<th>
							Date
						</th>

						<td>
							{{ commande.commandeDate
								? commande.commandeDate|date('d/m/Y à H:i')
								: 'Non renseignée'
							}}
						</td>
					</tr>

					<tr>
						<th>
							Utilisateur
						</th>

						<td>

							{% if commande.utilisateur %}

								{{ commande.utilisateur.utilisateurPrenom }}
								{{ commande.utilisateur.utilisateurNom }}

								<br>

								<span class="text-muted">
									{{ commande.utilisateur.utilisateurEmail }}
								</span>

							{% else %}

								<span class="text-muted">
									Utilisateur supprimé
								</span>

							{% endif %}

						</td>
					</tr>

					<tr>
						<th>
							Statut
						</th>

						<td>

							{% if commande.commandeStatut == 'en attente' %}

								<span class="badge bg-warning">
									En attente
								</span>

							{% elseif commande.commandeStatut == 'en préparation' %}

								<span class="badge bg-info">
									En préparation
								</span>

							{% elseif commande.commandeStatut == 'prête' %}

								<span class="badge bg-primary">
									Prête
								</span>

							{% elseif commande.commandeStatut == 'en livraison' %}

								<span class="badge bg-info">
									En livraison
								</span>

							{% elseif commande.commandeStatut == 'livrée' %}

								<span class="badge bg-success">
									Livrée
								</span>

							{% elseif commande.commandeStatut == 'annulée' %}

								<span class="badge bg-danger">
									Annulée
								</span>

							{% else %}

								<span class="badge bg-secondary">
									{{ commande.commandeStatut }}
								</span>

							{% endif %}

						</td>
					</tr>

					<tr>
						<th>
							Total
						</th>

						<td>
							<strong>
								{{ commande.commandeTotal|number_format(2, ',', ' ') }}
								€
							</strong>
						</td>
					</tr>

				</tbody>
			</table>

		</div>

	</div>

	{# Gestion du statut de la commande. #}
	<div class="card mt-4">

		<div class="card-header">
			<h5 class="card-title mb-0">
				Statut de la commande
			</h5>
		</div>

		<div class="card-body">

			{# L'administrateur peut sélectionner librement le statut. #}

			{% if is_granted('ROLE_ADMIN') %}

				<form
					method="post"
					action="{{ path('app_admin_commande_status', {'id': commande.id}) }}"
					class="row g-3 align-items-end"
				>

					<div class="col-12 col-md">

						<label
							for="commande-statut"
							class="form-label"
						>
							Statut
						</label>

						<select
							id="commande-statut"
							name="commande_statut"
							class="form-select"
							required
						>

							<option
								value="en attente"
								{% if commande.commandeStatut == 'en attente' %}
									selected
								{% endif %}
							>
								En attente
							</option>

							<option
								value="en préparation"
								{% if commande.commandeStatut == 'en préparation' %}
									selected
								{% endif %}
							>
								En préparation
							</option>

							<option
								value="prête"
								{% if commande.commandeStatut == 'prête' %}
									selected
								{% endif %}
							>
								Prête
							</option>

							<option
								value="en livraison"
								{% if commande.commandeStatut == 'en livraison' %}
									selected
								{% endif %}
							>
								En livraison
							</option>

							<option
								value="livrée"
								{% if commande.commandeStatut == 'livrée' %}
									selected
								{% endif %}
							>
								Livrée
							</option>

							<option
								value="annulée"
								{% if commande.commandeStatut == 'annulée' %}
									selected
								{% endif %}
							>
								Annulée
							</option>

						</select>

					</div>

					<div class="col-12 col-md-auto">

						<input
							type="hidden"
							name="_token"
							value="{{ csrf_token('commande_status' ~ commande.id) }}"
						>

						<button
							type="submit"
							class="btn btn-primary"
						>
							Mettre à jour le statut
						</button>

					</div>

				</form>

			{# Le préparateur fait progresser la préparation. #}

			{% elseif is_granted('ROLE_PREPARATEUR') %}

				{% if commande.commandeStatut == 'en attente' %}

					<form
						method="post"
						action="{{ path('app_admin_commande_status', {'id': commande.id}) }}"
					>

						<input
							type="hidden"
							name="commande_statut"
							value="en préparation"
						>

						<input
							type="hidden"
							name="_token"
							value="{{ csrf_token('commande_status' ~ commande.id) }}"
						>

						<p class="text-muted">
							La commande est en attente de préparation.
						</p>

						<button
							type="submit"
							class="btn btn-primary"
						>
							Commencer la préparation
						</button>

					</form>

				{% elseif commande.commandeStatut == 'en préparation' %}

					<form
						method="post"
						action="{{ path('app_admin_commande_status', {'id': commande.id}) }}"
					>

						<input
							type="hidden"
							name="commande_statut"
							value="prête"
						>

						<input
							type="hidden"
							name="_token"
							value="{{ csrf_token('commande_status' ~ commande.id) }}"
						>

						<p class="text-muted">
							La commande est actuellement en préparation.
						</p>

						<button
							type="submit"
							class="btn btn-success"
						>
							Déclarer la commande prête
						</button>

					</form>

				{% else %}

					<p class="text-muted mb-0">
						Cette commande ne nécessite plus d'action de préparation.
					</p>

				{% endif %}

			{# L'accueil remet une commande prête au client. #}

			{% elseif is_granted('ROLE_ACCUEIL') %}

				{% if commande.commandeStatut == 'prête' %}

					<form
						method="post"
						action="{{ path('app_admin_commande_status', {'id': commande.id}) }}"
					>

						<input
							type="hidden"
							name="commande_statut"
							value="livrée"
						>

						<input
							type="hidden"
							name="_token"
							value="{{ csrf_token('commande_status' ~ commande.id) }}"
						>

						<p class="text-muted">
							La commande est prête et peut être remise au client.
						</p>

						<button
							type="submit"
							class="btn btn-success"
						>
							Déclarer la commande livrée
						</button>

					</form>

				{% else %}

					<p class="text-muted mb-0">
						La commande doit être prête avant de pouvoir être remise au client.
					</p>

				{% endif %}

			{% endif %}

		</div>

	</div>

	{# Articles présents dans la commande. #}
	{{ include('admin_commande/_details.html.twig') }}

	{# Retour à la liste des commandes. #}
	<div class="mt-3">

		<a
			href="{{ path('app_admin_commande_index') }}"
			class="btn btn-secondary"
		>
			Retour à la liste
		</a>

	</div>

{% endblock %}