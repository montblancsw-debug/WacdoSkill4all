{# Formulaire sécurisé de suppression. #}
<form
    method="post"
    action="{{ path('app_admin_utilisateur_delete', {'id': utilisateur.id}) }}"
    class="d-inline"
    onsubmit="return confirm('Voulez-vous vraiment supprimer cet utilisateur ?');"
>

    {# Protège la suppression avec un jeton CSRF. #}
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('delete' ~ utilisateur.id) }}"
    >

    {# Supprime uniquement l'utilisateur sélectionné. #}
    <button class="btn btn-danger btn-sm">
        Supprimer
    </button>

</form>