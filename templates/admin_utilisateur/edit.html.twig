{% extends 'base-backend.html.twig' %}

{% block title %}
    Modifier {{ utilisateur.utilisateurNom }} | Wacdo
{% endblock %}

{% block body %}
    {# Affiche le titre de modification. #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                Modifier l'utilisateur
            </h1>
            <p class="text-muted mb-0">
                {{ utilisateur.utilisateurPrenom }}
                {{ utilisateur.utilisateurNom }}
            </p>
        </div>

        {# Permet de supprimer l'utilisateur. #}
        {{ include('admin_utilisateur/_delete_form.html.twig') }}
    </div>

    {# Affiche le formulaire de modification. #}
    {{ include('admin_utilisateur/_form.html.twig', {
        'button_label': 'Mettre à jour'
    }) }}

    {# Retourne vers la liste. #}
    <div class="mt-3">
        <a
            href="{{ path('app_admin_utilisateur_index') }}"
            class="btn btn-secondary"
        >
            Retour à la liste
        </a>
    </div>
{% endblock %}