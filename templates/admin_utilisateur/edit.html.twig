{% extends 'base-backend.html.twig' %}

{% block title %}
	Modifier {{ utilisateur.utilisateurNom }} | Wacdo
{% endblock %}

{% block body %}

	{# En-tête de l'utilisateur à modifier. #}
	<div class="mb-4">
		<h1 class="h3 mb-1">
			Modifier l'utilisateur
		</h1>

		<p class="text-muted mb-0">
			{{ utilisateur.utilisateurPrenom }}
			{{ utilisateur.utilisateurNom }}
		</p>
	</div>

	{# Formulaire de modification. #}
	{{ include('admin_utilisateur/_form.html.twig', {
		'button_label': 'Mettre à jour'
	}) }}

	{# Retour à la liste des utilisateurs. #}
	<div class="mt-3">
		<a
			href="{{ path('app_admin_utilisateur_index') }}"
			class="btn btn-secondary"
		>
			Retour à la liste
		</a>
	</div>

{% endblock %}