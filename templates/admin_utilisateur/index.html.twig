{% extends 'base-backend.html.twig' %}

{% block title %}
    Gestion des utilisateurs | Wacdo
{% endblock %}

{% block body %}

    {# Affiche l'en-tête de la page. #}
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                Gestion des utilisateurs
            </h1>

            <p class="text-muted mb-0">
                Consultez et gérez les comptes du back-office Wacdo.
            </p>
        </div>

        <a
            href="{{ path('app_admin_utilisateur_new') }}"
            class="btn btn-primary"
        >
            Ajouter un utilisateur
        </a>

    </div>

    {# Affiche la liste des utilisateurs. #}
    <div class="card">

        <div class="card-header">
            <h5 class="card-title mb-0">
                Liste des utilisateurs
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Email</th>
                            <th>Rôle</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for utilisateur in utilisateurs %}

                            <tr>

                                <td>
                                    {{ utilisateur.id }}
                                </td>

                                <td>
                                    <strong>
                                        {{ utilisateur.utilisateurNom }}
                                    </strong>
                                </td>

                                <td>
                                    {% if utilisateur.utilisateurPrenom %}
                                        {{ utilisateur.utilisateurPrenom }}
                                    {% else %}
                                        <span class="text-muted">
                                            Non renseigné
                                        </span>
                                    {% endif %}
                                </td>

                                <td>
                                    {{ utilisateur.utilisateurEmail }}
                                </td>

                                <td>

                                    {% if utilisateur.utilisateurRole == 'ROLE_ADMIN' %}

                                        <span class="badge bg-danger">
                                            Administrateur
                                        </span>

                                    {% elseif utilisateur.utilisateurRole == 'ROLE_PREPARATEUR' %}

                                        <span class="badge bg-warning">
                                            Préparateur
                                        </span>

                                    {% elseif utilisateur.utilisateurRole == 'ROLE_ACCUEIL' %}

                                        <span class="badge bg-info">
                                            Accueil
                                        </span>

                                    {% else %}

                                        <span class="badge bg-secondary">
                                            {{ utilisateur.utilisateurRole }}
                                        </span>

                                    {% endif %}

                                </td>

                                <td class="text-end">

                                    <a
                                        href="{{ path('app_admin_utilisateur_show', {'id': utilisateur.id}) }}"
                                        class="btn btn-info btn-sm"
                                    >
                                        Voir
                                    </a>

                                    <a
                                        href="{{ path('app_admin_utilisateur_edit', {'id': utilisateur.id}) }}"
                                        class="btn btn-warning btn-sm"
                                    >
                                        Modifier
                                    </a>

                                    {{ include('admin_utilisateur/_delete_form.html.twig') }}

                                </td>

                            </tr>

                        {% else %}

                            <tr>
                                <td
                                    colspan="6"
                                    class="text-center text-muted"
                                >
                                    Aucun utilisateur enregistré.
                                </td>
                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </div>

{% endblock %}