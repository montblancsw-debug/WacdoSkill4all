{% extends 'base-backend.html.twig' %}

{% block title %}
	Gestion des utilisateurs | Wacdo
{% endblock %}

{% block body %}

	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>

			<h1 class="h3 mb-1">
				Gestion des utilisateurs
			</h1>

			<p class="text-muted mb-0">
				Consultez et gérez les comptes Wacdo.
			</p>

		</div>

		<a
			href="{{ path('app_admin_utilisateur_new') }}"
			class="btn btn-primary"
		>
			Ajouter un utilisateur
		</a>

	</div>

	<div class="card">

		<div class="card-header">

			<h5 class="card-title mb-0">
				Liste des utilisateurs
			</h5>

		</div>

		<div class="card-body">

			<form
				method="post"
				action="{{ path('app_admin_utilisateur_index') }}"
				class="row g-2 mb-4"
			>

				<div class="col-12 col-lg">

					<input
						type="text"
						name="search"
						class="form-control"
						placeholder="Rechercher par ID, nom, prénom ou email..."
						value="{{ search|default('') }}"
					>

				</div>

				<div class="col-12 col-md-4 col-lg-3">

					<select
						name="role"
						class="form-select"
					>

						<option value="">
							Tous les rôles
						</option>

						<option
							value="ROLE_ADMIN"
							{% if role|default('') == 'ROLE_ADMIN' %}
								selected
							{% endif %}
						>
							Administrateur
						</option>

						<option
							value="ROLE_PREPARATEUR"
							{% if role|default('') == 'ROLE_PREPARATEUR' %}
								selected
							{% endif %}
						>
							Préparateur
						</option>

						<option
							value="ROLE_ACCUEIL"
							{% if role|default('') == 'ROLE_ACCUEIL' %}
								selected
							{% endif %}
						>
							Accueil
						</option>

						<option
							value="ROLE_USER"
							{% if role|default('') == 'ROLE_USER' %}
								selected
							{% endif %}
						>
							Client
						</option>

					</select>

				</div>

				<div class="col-12 col-md-auto">

					<button
						type="submit"
						class="btn btn-primary w-100"
					>
						Rechercher
					</button>

				</div>

			</form>

			<div class="table-responsive">

				<table class="table table-hover align-middle">

					<thead>

						<tr>
							<th>ID</th>
							<th>Nom</th>
							<th>Prénom</th>
							<th>Email</th>
							<th>Rôle</th>

							<th class="text-end">
								Actions
							</th>
						</tr>

					</thead>

					<tbody>

						{% for utilisateur in utilisateurs %}

							<tr>

								<td>
									{{ utilisateur.id }}
								</td>

								<td>

									<strong>
										{{ utilisateur.utilisateurNom }}
									</strong>

								</td>

								<td>

									{% if utilisateur.utilisateurPrenom %}

										{{ utilisateur.utilisateurPrenom }}

									{% else %}

										<span class="text-muted">
											Non renseigné
										</span>

									{% endif %}

								</td>

								<td>
									{{ utilisateur.utilisateurEmail }}
								</td>

								<td>

									{% if utilisateur.utilisateurRole == 'ROLE_ADMIN' %}

										<span class="badge bg-danger">
											Administrateur
										</span>

									{% elseif utilisateur.utilisateurRole == 'ROLE_PREPARATEUR' %}

										<span class="badge bg-warning">
											Préparateur
										</span>

									{% elseif utilisateur.utilisateurRole == 'ROLE_ACCUEIL' %}

										<span class="badge bg-info">
											Accueil
										</span>

									{% elseif utilisateur.utilisateurRole == 'ROLE_USER' %}

										<span class="badge bg-secondary">
											Client
										</span>

									{% endif %}

								</td>

								<td class="text-end">

									<a
										href="{{ path('app_admin_utilisateur_show', {'id': utilisateur.id}) }}"
										class="btn btn-info btn-sm"
									>
										Voir
									</a>

									<a
										href="{{ path('app_admin_utilisateur_edit', {'id': utilisateur.id}) }}"
										class="btn btn-warning btn-sm"
									>
										Modifier
									</a>

									{{ include('admin_utilisateur/_delete_form.html.twig') }}

								</td>

							</tr>

						{% else %}

							<tr>

								<td
									colspan="6"
									class="text-center text-muted"
								>
									Aucun utilisateur ne correspond à votre recherche.
								</td>

							</tr>

						{% endfor %}

					</tbody>

				</table>

			</div>

		</div>

	</div>

{% endblock %}