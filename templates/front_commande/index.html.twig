{# Liste des commandes du client. #}

{% extends 'base.html.twig' %}

{% block title %}
	Mes commandes | Wacdo
{% endblock %}

{% block body %}

	<section class="front-section">

		<div class="mb-4">

			<h1 class="h2 mb-1">
				Mes commandes
			</h1>

			<p class="text-muted mb-0">
				Consultez l'historique et le statut de vos commandes Wacdo.
			</p>

		</div>

		<div class="card front-card">

			<div class="card-body">

				<div class="table-responsive">

					<table class="table table-hover align-middle">

						<thead>

							<tr>
								<th>Commande</th>
								<th>Date</th>
								<th>Articles</th>
								<th>Statut</th>
								<th>Total</th>
								<th class="text-end">
									Actions
								</th>
							</tr>

						</thead>

						<tbody>

							{% for commande in commandes %}

								<tr>

									<td>

										<strong>
											#{{ commande.id }}
										</strong>

									</td>

									<td>
										{{ commande.commandeDate
											? commande.commandeDate|date('d/m/Y à H:i')
											: 'Non renseignée'
										}}
									</td>

									<td>
										{{ commande.details|length }}
									</td>

									<td>

										{% if commande.commandeStatut == 'en attente' %}

											<span class="badge bg-warning">
												En attente
											</span>

										{% elseif commande.commandeStatut == 'en préparation' %}

											<span class="badge bg-info">
												En préparation
											</span>

										{% elseif commande.commandeStatut == 'prête' %}

											<span class="badge bg-primary">
												Prête
											</span>

										{% elseif commande.commandeStatut == 'en livraison' %}

											<span class="badge bg-info">
												En livraison
											</span>

										{% elseif commande.commandeStatut == 'livrée' %}

											<span class="badge bg-success">
												Livrée
											</span>

										{% elseif commande.commandeStatut == 'annulée' %}

											<span class="badge bg-danger">
												Annulée
											</span>

										{% endif %}

									</td>

									<td>

										<strong>
											{{ commande.commandeTotal|number_format(2, ',', ' ') }}
											€
										</strong>

									</td>

									<td class="text-end">

										<a
											href="{{ path('app_front_commande_show', {'id': commande.id}) }}"
											class="btn btn-outline-primary btn-sm"
										>
											Voir le détail
										</a>

										{% if commande.commandeStatut in ['en attente', 'en préparation'] %}

											<a
												href="{{ path('app_front_commande_edit', {'id': commande.id}) }}"
												class="btn btn-primary btn-sm"
											>
												Modifier
											</a>

										{% endif %}

										{% if commande.commandeStatut in ['en attente', 'en préparation', 'prête'] %}

											<form
												method="post"
												action="{{ path('app_front_commande_cancel', {'id': commande.id}) }}"
												class="d-inline"
												onsubmit="return confirm('Voulez-vous vraiment annuler cette commande ?');"
											>

												<input
													type="hidden"
													name="_token"
													value="{{ csrf_token('front_commande_cancel' ~ commande.id) }}"
												>

												<button
													type="submit"
													class="btn btn-danger btn-sm"
												>
													Annuler
												</button>

											</form>

										{% endif %}

									</td>

								</tr>

							{% else %}

								<tr>

									<td
										colspan="6"
										class="text-center text-muted"
									>
										Vous n'avez encore aucune commande.
									</td>

								</tr>

							{% endfor %}

						</tbody>

					</table>

				</div>

			</div>

		</div>

	</section>

{% endblock %}