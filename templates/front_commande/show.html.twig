{# Détail d'une commande client. #}

{% extends 'base.html.twig' %}

{% block title %}
	Commande #{{ commande.id }} | Wacdo
{% endblock %}

{% block body %}

	<section class="front-section">

		<div class="mb-4">

			<a
				href="{{ path('app_front_commande') }}"
				class="btn btn-secondary"
			>
				Retour à mes commandes
			</a>

		</div>

		<div class="d-flex justify-content-between align-items-start mb-4">

			<div>

				<h1 class="h2 mb-1">
					Commande #{{ commande.id }}
				</h1>

				<p class="text-muted mb-0">
					{{ commande.commandeDate
						? commande.commandeDate|date('d/m/Y à H:i')
						: ''
					}}
				</p>

			</div>

			<div>

				{% if commande.commandeStatut == 'en attente' %}

					<span class="badge text-bg-warning">
						En attente
					</span>

				{% elseif commande.commandeStatut == 'préparée' %}

					<span class="badge text-bg-info">
						Préparée
					</span>

				{% elseif commande.commandeStatut == 'livrée' %}

					<span class="badge text-bg-success">
						Livrée
					</span>

				{% endif %}

			</div>

		</div>

		<div class="card front-card">

			<div class="card-body">

				<div class="table-responsive">

					<table class="table align-middle">

						<thead>
							<tr>
								<th>Image</th>
								<th>Produit</th>
								<th>Prix unitaire</th>
								<th>Quantité</th>
								<th>Total</th>
							</tr>
						</thead>

						<tbody>

							{% for detail in commande.details %}

								{% if detail.produit %}

									<tr>

										<td>

											{% if detail.produit.produitImage %}

												<img
													src="{{ asset('images/produits/' ~ detail.produit.produitImage) }}?v={{ detail.produit.updatedAt ? detail.produit.updatedAt|date('U') : '1' }}"
													alt="{{ detail.produit.produitNom }}"
													class="front-cart-image"
												>

											{% endif %}

										</td>

										<td>

											<strong>
												{{ detail.produit.produitNom }}
											</strong>

										</td>

										<td>
											{{ detail.detailUnitaire|number_format(2, ',', ' ') }}
											€
										</td>

										<td>
											{{ detail.detailQuantite }}
										</td>

										<td>

											<strong>
												{{ detail.detailTotal|number_format(2, ',', ' ') }}
												€
											</strong>

										</td>

									</tr>

								{% endif %}

							{% else %}

								<tr>

									<td
										colspan="5"
										class="text-center text-muted"
									>
										Aucun article.
									</td>

								</tr>

							{% endfor %}

						</tbody>

					</table>

				</div>

			</div>

		</div>

		<div class="row justify-content-end mt-4">

			<div class="col-12 col-md-6 col-lg-4">

				<div class="card front-cart-summary">

					<div class="card-body">

						<div class="front-cart-total">

							<span>
								Total
							</span>

							<strong>
								{{ commande.commandeTotal|number_format(2, ',', ' ') }}
								€
							</strong>

						</div>

					</div>

				</div>

			</div>

		</div>

	</section>

{% endblock %}