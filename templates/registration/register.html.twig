{# Page d'inscription Wacdo. #}

{% extends 'base.html.twig' %}

{% block title %}
	Inscription | Wacdo
{% endblock %}

{% block body %}

	<section class="front-section">

		<div class="row justify-content-center">
			<div class="col-12 col-md-9 col-lg-6">

				<div class="card front-card">

					<div class="card-body p-4">

						<div class="text-center mb-4">

							<h1 class="h2">
								Créer un compte
							</h1>

							<p class="text-muted mb-0">
								Créez votre compte client Wacdo.
							</p>

						</div>

						{{ form_start(registrationForm, {
							'attr': {
								'data-live-validation': 'true'
							}
						}) }}

						{{ form_errors(registrationForm) }}

						<div class="mb-3">
							{{ form_label(registrationForm.utilisateur_nom) }}
							{{ form_widget(registrationForm.utilisateur_nom) }}
							{{ form_errors(registrationForm.utilisateur_nom) }}
						</div>

						<div class="mb-3">
							{{ form_label(registrationForm.utilisateur_prenom) }}
							{{ form_widget(registrationForm.utilisateur_prenom) }}
							{{ form_errors(registrationForm.utilisateur_prenom) }}
						</div>

						<div class="mb-3">
							{{ form_label(registrationForm.utilisateur_email) }}
							{{ form_widget(registrationForm.utilisateur_email) }}
							{{ form_errors(registrationForm.utilisateur_email) }}
						</div>

						<div class="mb-3">
							{{ form_label(registrationForm.plain_password.first) }}
							{{ form_widget(registrationForm.plain_password.first) }}
							{{ form_errors(registrationForm.plain_password.first) }}
						</div>

						<div class="mb-4">
							{{ form_label(registrationForm.plain_password.second) }}
							{{ form_widget(registrationForm.plain_password.second) }}
							{{ form_errors(registrationForm.plain_password.second) }}
							{{ form_errors(registrationForm.plain_password) }}
						</div>

						<div class="d-grid">
							<button
								type="submit"
								class="btn btn-primary"
							>
								Créer mon compte
							</button>
						</div>

						{{ form_end(registrationForm) }}

						<div class="text-center mt-4">
							<span class="text-muted">
								Vous avez déjà un compte ?
							</span>

							<a href="{{ path('app_login') }}">
								Se connecter
							</a>
						</div>

					</div>

				</div>

			</div>
		</div>

	</section>

{% endblock %}