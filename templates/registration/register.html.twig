{% extends 'base.html.twig' %}

{% block title %}
	Inscription | Wacdo
{% endblock %}

{% block body %}

	<section class="front-section">

		<div class="row justify-content-center">
			<div class="col-12 col-md-9 col-lg-6">
				<div class="card front-card">
					<div class="card-body p-4">

						{# En-tête du formulaire d'inscription. #}
						<div class="text-center mb-4">
							<h1 class="h2">
								Créer un compte
							</h1>

							<p class="text-muted mb-0">
								Créez votre compte client Wacdo.
							</p>
						</div>

						{# Formulaire de création du compte. #}
						{{ form_start(registrationForm, {
							'attr': {
								'data-live-validation': 'true'
							}
						}) }}

						{{ form_errors(registrationForm) }}

						<div class="mb-3">
							{{ form_label(registrationForm.utilisateur_nom) }}
							{{ form_widget(registrationForm.utilisateur_nom) }}
							{{ form_errors(registrationForm.utilisateur_nom) }}
						</div>

						<div class="mb-3">
							{{ form_label(registrationForm.utilisateur_prenom) }}
							{{ form_widget(registrationForm.utilisateur_prenom) }}
							{{ form_errors(registrationForm.utilisateur_prenom) }}
						</div>

						<div class="mb-3">
							{{ form_label(registrationForm.utilisateur_email) }}
							{{ form_widget(registrationForm.utilisateur_email) }}
							{{ form_errors(registrationForm.utilisateur_email) }}
						</div>

						<div class="mb-3">
							{{ form_label(registrationForm.plain_password.first) }}
							{{ form_widget(registrationForm.plain_password.first) }}
							{{ form_errors(registrationForm.plain_password.first) }}
						</div>

						<div class="mb-4">
							{{ form_label(registrationForm.plain_password.second) }}
							{{ form_widget(registrationForm.plain_password.second) }}
							{{ form_errors(registrationForm.plain_password.second) }}
							{{ form_errors(registrationForm.plain_password) }}
						</div>

						<div class="d-grid">
							<button type="submit" class="btn btn-primary">
								Créer mon compte
							</button>
						</div>

						{{ form_end(registrationForm) }}

						{# Accès à la connexion pour un compte existant. #}
						<div class="text-center mt-4">
							<span class="text-muted">
								Vous avez déjà un compte ?
							</span>

							<a href="{{ path('app_login') }}">
								Se connecter
							</a>
						</div>

					</div>
				</div>
			</div>
		</div>

	</section>

{% endblock %}

{% block javascripts %}

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const form = document.querySelector('form[data-live-validation="true"]');

			if (!form) {
				return;
			}

			const email = form.querySelector('input[type="email"]');
			const passwordFields = form.querySelectorAll('input[type="password"]');
			const password = passwordFields[0];
			const confirmation = passwordFields[1];

			// Vérifie le format de l'adresse email.
			function validateEmail() {
				if (!email) {
					return;
				}

				email.setCustomValidity('');

				const value = email.value.trim();
				const emailPattern = /^[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$/;

				if (value === '') {
					return;
				}

				if (!value.includes('@')) {
					email.setCustomValidity(
						"L'adresse email doit contenir un @."
					);

					return;
				}

				const parts = value.split('@');

				if (
					parts.length !== 2
					|| parts[0].trim() === ''
					|| parts[1].trim() === ''
				) {
					email.setCustomValidity(
						'Veuillez saisir une adresse email complète.'
					);

					return;
				}

				if (!emailPattern.test(value)) {
					email.setCustomValidity(
						'Veuillez saisir une adresse email complète avec une extension valide, par exemple .fr, .com ou .org.'
					);
				}
			}

			// Vérifie la longueur et la confirmation du mot de passe.
			function validatePasswords() {
				if (!password || !confirmation) {
					return;
				}

				password.setCustomValidity('');
				confirmation.setCustomValidity('');

				if (password.value !== '' && password.value.length < 8) {
					password.setCustomValidity(
						'Votre mot de passe doit comporter au moins 8 caractères. Il en compte actuellement '
						+ password.value.length
						+ '.'
					);

					return;
				}

				if (
					password.value !== ''
					&& confirmation.value !== ''
					&& password.value !== confirmation.value
				) {
					password.setCustomValidity(
						'Le mot de passe est différent de la confirmation.'
					);

					confirmation.setCustomValidity(
						'La confirmation est différente du mot de passe.'
					);
				}
			}

			if (email) {
				email.addEventListener('input', validateEmail);
				email.addEventListener('blur', validateEmail);
				email.addEventListener('invalid', validateEmail);
			}

			if (password && confirmation) {
				password.addEventListener('input', validatePasswords);
				password.addEventListener('blur', validatePasswords);
				password.addEventListener('invalid', validatePasswords);

				confirmation.addEventListener('input', validatePasswords);
				confirmation.addEventListener('blur', validatePasswords);
				confirmation.addEventListener('invalid', validatePasswords);
			}
		});
	</script>

{% endblock %}