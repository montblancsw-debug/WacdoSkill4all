{% extends 'base.html.twig' %}

{% block title %}
	Mon profil | Wacdo
{% endblock %}

{% block body %}

	<section class="front-section">

		{# En-tête du profil. #}
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div>
				<h1 class="h2 mb-1">
					Mon profil
				</h1>

				<p class="text-muted mb-0">
					Consultez les informations de votre compte.
				</p>
			</div>

			<a
				href="{{ path('app_profil_edit') }}"
				class="btn btn-primary"
			>
				Modifier mon profil
			</a>
		</div>

		{# Informations du compte utilisateur. #}
		<div class="card front-card">
			<div class="card-body">
				<div class="row g-4">

					<div class="col-12 col-md-6">
						<span class="text-muted d-block mb-1">
							Nom
						</span>

						<strong>
							{{ utilisateur.utilisateurNom }}
						</strong>
					</div>

					<div class="col-12 col-md-6">
						<span class="text-muted d-block mb-1">
							Prénom
						</span>

						<strong>
							{{ utilisateur.utilisateurPrenom ?: 'Non renseigné' }}
						</strong>
					</div>

					<div class="col-12 col-md-6">
						<span class="text-muted d-block mb-1">
							Adresse email
						</span>

						<strong>
							{{ utilisateur.utilisateurEmail }}
						</strong>
					</div>

					<div class="col-12 col-md-6">
						<span class="text-muted d-block mb-1">
							Rôle
						</span>

						<strong>
							{% if utilisateur.utilisateurRole == 'ROLE_ADMIN' %}
								Administrateur
							{% elseif utilisateur.utilisateurRole == 'ROLE_PREPARATEUR' %}
								Préparateur
							{% elseif utilisateur.utilisateurRole == 'ROLE_ACCUEIL' %}
								Accueil
							{% else %}
								Utilisateur
							{% endif %}
						</strong>
					</div>

				</div>
			</div>
		</div>

	</section>

{% endblock %}