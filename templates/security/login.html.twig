{% extends 'base.html.twig' %}

{% block title %}
	Connexion | Wacdo
{% endblock %}

{% block body %}

	<div class="container py-5">
		<div class="row justify-content-center">
			<div class="col-12 col-md-8 col-lg-5">
				<div class="card shadow-sm">
					<div class="card-body p-4">

						{# En-tête du formulaire de connexion. #}
						<div class="text-center mb-4">
							<h1 class="h3">
								Connexion
							</h1>

							<p class="text-muted">
								Accès à Wacdo
							</p>
						</div>

						{# Affiche une erreur lorsque la connexion échoue. #}
						{% if error %}
							<div class="alert alert-danger" role="alert">
								Adresse email ou mot de passe incorrect.
							</div>
						{% endif %}

						{# Formulaire de connexion. #}
						<form method="post">

							<div class="mb-3">
								<label for="inputEmail" class="form-label">
									Adresse email
								</label>

								<input
									type="email"
									value="{{ last_username }}"
									name="email"
									id="inputEmail"
									class="form-control"
									autocomplete="email"
									placeholder="Ex : blabla@wacdo.fr"
									required
									autofocus
								>
							</div>

							<div class="mb-3">
								<label for="inputPassword" class="form-label">
									Mot de passe
								</label>

								<input
									type="password"
									name="password"
									id="inputPassword"
									class="form-control"
									autocomplete="current-password"
									required
								>
							</div>

							<input
								type="hidden"
								name="_csrf_token"
								value="{{ csrf_token('authenticate') }}"
							>

							<div class="form-check mb-4">
								<input
									type="checkbox"
									name="_remember_me"
									id="rememberMe"
									class="form-check-input"
								>

								<label for="rememberMe" class="form-check-label">
									Se souvenir de moi
								</label>
							</div>

							<div class="d-grid">
								<button type="submit" class="btn btn-primary">
									Se connecter
								</button>
							</div>

						</form>

						{# Accès à l'inscription pour un nouvel utilisateur. #}
						<div class="text-center mt-4">
							<span class="text-muted">
								Vous n'avez pas encore de compte ?
							</span>

							<a href="{{ path('app_register') }}">
								Créer un compte
							</a>
						</div>

						<div class="d-grid mt-3">
							<a href="{{ path('app_front_home') }}" class="btn btn-secondary">
								Retour au site
							</a>
						</div>

					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}