<!DOCTYPE html>

<html lang="fr">

	<head>

		<meta charset="UTF-8">

		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			{% block title %}
				Bienvenue sur l'admin
			{% endblock %}
		</title>

		{# Charge les styles AdminKit. #}
		<link
		rel="stylesheet" href="{{ asset('css/app.css') }}">

		{# Charge la police utilisée par AdminKit. #}
		<link
		href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

		{# Styles des messages Flash du back-office. #}
		<style>

			.wacdo-flash {
				position: relative;
				padding: 1rem 3.5rem 1rem 1rem;
				margin-bottom: 1rem;
				border: 1px solid transparent;
				border-radius: 0.375rem;
				font-weight: 500;
				box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
			}

			.wacdo-flash-success {
				color: #0f5132;
				background-color: #d1e7dd;
				border-color: #badbcc;
			}

			.wacdo-flash-danger {
				color: #842029;
				background-color: #f8d7da;
				border-color: #f5c2c7;
			}

			.wacdo-flash-warning {
				color: #664d03;
				background-color: #fff3cd;
				border-color: #ffecb5;
			}

			.wacdo-flash-info {
				color: #055160;
				background-color: #cff4fc;
				border-color: #b6effb;
			}

			.wacdo-flash-close {
				position: absolute;
				top: 50%;
				right: 1rem;
				transform: translateY(-50%);
				border: 0;
				background: transparent;
				font-size: 1.4rem;
				line-height: 1;
				cursor: pointer;
				opacity: 0.65;
			}

			.wacdo-flash-close:hover {
				opacity: 1;
			}
		</style>

		{% block stylesheet %}{% endblock %}

	</head>

	<body>

		<div
			class="wrapper">

			{# Affiche le menu latéral du back-office. #}
			{{ include('inc/_backend-left-nav.html.twig') }}

			<div
				class="main">

				{# Affiche la barre de navigation supérieure. #}
				{{ include('inc/_backend-top-nav.html.twig') }}

				<main class="content">

					<div
						class="container-fluid p-0">

						{# Affiche les messages Flash Symfony. #}
						{% for label, messages in app.flashes %}

							{% for message in messages %}

								{# Définit la couleur du Flash. #}
								{% set flashClass = 'wacdo-flash-info' %}

								{% if label == 'success' %}

									{% set flashClass = 'wacdo-flash-success' %}

								{% elseif label == 'danger' or label == 'error' %}

									{% set flashClass = 'wacdo-flash-danger' %}

								{% elseif label == 'warning' %}

									{% set flashClass = 'wacdo-flash-warning' %}

								{% elseif label == 'info' %}

									{% set flashClass = 'wacdo-flash-info' %}

								{% endif %}

								<div class="wacdo-flash {{ flashClass }}" role="alert">

									{{ message }}

									{# Ferme le message Flash. #}
									<button type="button" class="wacdo-flash-close" aria-label="Fermer">
										&times;
									</button>

								</div>

							{% endfor %}

						{% endfor %}


						{# Affiche le contenu de la page actuelle. #}
						{% block body %}{% endblock %}

					</div>

				</main>


				<footer class="footer">

					<div class="container-fluid">

						<div class="row text-muted">

							<div class="col-6 text-start">

								<p class="mb-0">

									<a class="text-muted" href="https://adminkit.io/" target="_blank">
										<strong>
											AdminKit
										</strong>
									</a>

									-

									<a class="text-muted" href="https://adminkit.io/" target="_blank">
										<strong>
											Bootstrap Admin Template
										</strong>
									</a>

									&copy;

								</p>

							</div>


							<div class="col-6 text-end">

								<ul class="list-inline">

									<li class="list-inline-item">

										<a class="text-muted" href="https://adminkit.io/" target="_blank">
											Support
										</a>

									</li>

									<li class="list-inline-item">

										<a class="text-muted" href="https://adminkit.io/" target="_blank">
											Help Center
										</a>

									</li>

									<li class="list-inline-item">

										<a class="text-muted" href="https://adminkit.io/" target="_blank">
											Privacy
										</a>

									</li>

									<li class="list-inline-item">

										<a class="text-muted" href="https://adminkit.io/" target="_blank">
											Terms
										</a>

									</li>

								</ul>

							</div>

						</div>

					</div>

				</footer>

			</div>

		</div>


		{# Charge le JavaScript AdminKit. #}
		<script src="{{ asset('js/app.js') }}"></script>


		{# Gère les Flash et les contraintes des formulaires. #}
		<script>

			document.addEventListener('DOMContentLoaded', function () { // Permet de fermer manuellement les messages Flash.
document.querySelectorAll('.wacdo-flash-close').forEach(function (button) {

button.addEventListener('click', function () {

const flash = button.closest('.wacdo-flash');

if (flash) {
flash.remove();
}

});

});


// Sélectionne uniquement les formulaires du CRUD.
const forms = document.querySelectorAll('form[data-live-validation="true"]');


// Format complet attendu pour une adresse email.
const emailPattern = /^[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$/;


// Prépare les contraintes personnalisées d'un champ.
function prepareFieldValidity(field) { // Gestion spécifique des adresses email.
if (field.type === 'email') {

const value = field.value.trim();

// Supprime l'ancien message personnalisé.
field.setCustomValidity('');


// Un champ vide reste géré par required.
if (value === '') {
return;
}


// Vérifie la présence du caractère @.
if (! value.includes('@')) {

field.setCustomValidity("L'adresse email doit contenir un @.");

return;
}


const parts = value.split('@');


// Vérifie le contenu avant et après le @.
if (parts.length !== 2 || parts[0].trim() === '' || parts[1].trim() === '') {

field.setCustomValidity("Saisissez une adresse complète, par exemple utilisateur@wacdo.fr.");

return;
}


// Vérifie le domaine et son extension.
if (! emailPattern.test(value)) {

field.setCustomValidity("L'adresse email doit contenir une extension valide comme .fr, .com ou .org.");

}

}

}


// Affiche immédiatement la bulle de contrainte.
function validateField(field) { // Ignore les champs désactivés.
if (field.disabled || field.readOnly) {
return;
}


prepareFieldValidity(field);


// Affiche la bulle native du navigateur.
field.reportValidity();

}


forms.forEach(function (form) {

const fields = form.querySelectorAll('input:not([type="hidden"]):not([type="submit"]):not([type="button"]), select, textarea');


fields.forEach(function (field) {

let validationTimer;


// Vérifie le champ pendant la saisie.
field.addEventListener('input', function () {

clearTimeout(validationTimer);

validationTimer = setTimeout(function () {

validateField(field);

}, 350);

});


// Vérifie immédiatement les listes et cases.
field.addEventListener('change', function () {

clearTimeout(validationTimer);

validateField(field);

});


// Vérifie le champ lorsqu'on le quitte.
field.addEventListener('blur', function () {

clearTimeout(validationTimer);

validateField(field);

});

});


// Met à jour les contraintes avant l'envoi.
form.addEventListener('submit', function () {

fields.forEach(function (field) {

prepareFieldValidity(field);

});

});

});

});
		</script>


		{% block javascripts %}{% endblock %}

	</body>

</html>
