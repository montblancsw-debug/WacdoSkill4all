<!DOCTYPE html>

<html lang="fr">

	<head>

		<meta charset="UTF-8">

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		>
		<title>
			{% block title %}
				Bienvenue sur l'admin
			{% endblock %}
		</title>
		{# Charge les styles AdminKit. #}
		<link
			rel="stylesheet"
			href="{{ asset('css/app.css') }}"
		>
		{# Charge la police utilisée par AdminKit. #}
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap"
			rel="stylesheet"
		>
		{% block stylesheet %}
		{% endblock %}
	</head>
	<body>
		<div class="wrapper">
			{# Affiche le menu latéral du back-office. #}
			{{ include('inc/_backend-left-nav.html.twig') }}
			<div class="main">
				{# Affiche la barre de navigation supérieure. #}
				{{ include('inc/_backend-top-nav.html.twig') }}
				<main class="content">
					<div class="container-fluid p-0">
						{# Affiche les messages Flash Symfony. #}
						{% for label, messages in app.flashes %}
							{% for message in messages %}
								<div
									class="alert alert-{{ label }} alert-dismissible fade show"
									role="alert"
								>
									{{ message }}
									{# Permet de fermer le message. #}
									<button
										type="button"
										class="btn-close"
										data-bs-dismiss="alert"
										aria-label="Fermer"
									></button>
								</div>
							{% endfor %}
						{% endfor %}
						{# Affiche le contenu de la page actuelle. #}
						{% block body %}
						{% endblock %}
					</div>
				</main>
				<footer class="footer">
					<div class="container-fluid">
						<div class="row text-muted">
							<div class="col-6 text-start">
								<p class="mb-0">
									<a
										class="text-muted"
										href="https://adminkit.io/"
										target="_blank"
									>
										<strong>
											AdminKit
										</strong>
									</a>

									-

									<a
										class="text-muted"
										href="https://adminkit.io/"
										target="_blank"
									>
										<strong>
											Bootstrap Admin Template
										</strong>
									</a>

									&copy;

								</p>

							</div>


							<div class="col-6 text-end">

								<ul class="list-inline">

									<li class="list-inline-item">

										<a
											class="text-muted"
											href="https://adminkit.io/"
											target="_blank"
										>
											Support
										</a>

									</li>

									<li class="list-inline-item">

										<a
											class="text-muted"
											href="https://adminkit.io/"
											target="_blank"
										>
											Help Center
										</a>

									</li>

									<li class="list-inline-item">

										<a
											class="text-muted"
											href="https://adminkit.io/"
											target="_blank"
										>
											Privacy
										</a>

									</li>

									<li class="list-inline-item">

										<a
											class="text-muted"
											href="https://adminkit.io/"
											target="_blank"
										>
											Terms
										</a>

									</li>

								</ul>

							</div>

						</div>

					</div>

				</footer>

			</div>

		</div>


		{# Charge le JavaScript AdminKit et Bootstrap. #}
		<script src="{{ asset('js/app.js') }}"></script>

		{% block javascripts %}
		{% endblock %}

	</body>

</html>