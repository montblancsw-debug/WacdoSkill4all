<!DOCTYPE html>

<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			{% block title %}
				Bienvenue sur l'admin
			{% endblock %}
		</title>

		<link rel="stylesheet" href="{{ asset('css/app.css') }}">

		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap"
			rel="stylesheet"
		>

		<style>
			.wacdo-flash {
				position: relative;
				padding: 1rem 3.5rem 1rem 1rem;
				margin-bottom: 1rem;
				border: 1px solid transparent;
				border-radius: 0.375rem;
				font-weight: 500;
				box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
			}

			.wacdo-flash-success {
				color: #0f5132;
				background-color: #d1e7dd;
				border-color: #badbcc;
			}

			.wacdo-flash-danger {
				color: #842029;
				background-color: #f8d7da;
				border-color: #f5c2c7;
			}

			.wacdo-flash-warning {
				color: #664d03;
				background-color: #fff3cd;
				border-color: #ffecb5;
			}

			.wacdo-flash-info {
				color: #055160;
				background-color: #cff4fc;
				border-color: #b6effb;
			}

			.wacdo-flash-close {
				position: absolute;
				top: 50%;
				right: 1rem;
				transform: translateY(-50%);
				border: 0;
				background: transparent;
				color: inherit;
				font-size: 1.4rem;
				line-height: 1;
				cursor: pointer;
				opacity: 0.65;
				z-index: 2;
			}

			.wacdo-flash-close:hover {
				opacity: 1;
			}
		</style>

		{% block stylesheet %}{% endblock %}
	</head>

	<body>
		<div class="wrapper">

			{{ include('inc/_backend-left-nav.html.twig') }}

			<div class="main">

				{{ include('inc/_backend-top-nav.html.twig') }}

				<main class="content">
					<div class="container-fluid p-0">

						{% for label, messages in app.flashes %}
							{% for message in messages %}

								{% set flashClass = 'wacdo-flash-info' %}

								{% if label == 'success' %}
									{% set flashClass = 'wacdo-flash-success' %}
								{% elseif label == 'danger' or label == 'error' %}
									{% set flashClass = 'wacdo-flash-danger' %}
								{% elseif label == 'warning' %}
									{% set flashClass = 'wacdo-flash-warning' %}
								{% elseif label == 'info' %}
									{% set flashClass = 'wacdo-flash-info' %}
								{% endif %}

								<div class="wacdo-flash {{ flashClass }}" role="alert">
									{{ message }}

									<button
										type="button"
										class="wacdo-flash-close"
										aria-label="Fermer"
									>
										&times;
									</button>
								</div>

							{% endfor %}
						{% endfor %}

						{% block body %}{% endblock %}

					</div>
				</main>

				<footer class="footer">
					<div class="container-fluid">
						<div class="row text-muted">

							<div class="col-6 text-start">
								<p class="mb-0">
									<a
										class="text-muted"
										href="https://adminkit.io/"
										target="_blank"
									>
										<strong>AdminKit</strong>
									</a>

									-

									<a
										class="text-muted"
										href="https://adminkit.io/"
										target="_blank"
									>
										<strong>Bootstrap Admin Template</strong>
									</a>

									&copy;
								</p>
							</div>

							<div class="col-6 text-end">
								<ul class="list-inline">

									<li class="list-inline-item">
										<a
											class="text-muted"
											href="https://adminkit.io/"
											target="_blank"
										>
											Support
										</a>
									</li>

									<li class="list-inline-item">
										<a
											class="text-muted"
											href="https://adminkit.io/"
											target="_blank"
										>
											Help Center
										</a>
									</li>

									<li class="list-inline-item">
										<a
											class="text-muted"
											href="https://adminkit.io/"
											target="_blank"
										>
											Privacy
										</a>
									</li>

									<li class="list-inline-item">
										<a
											class="text-muted"
											href="https://adminkit.io/"
											target="_blank"
										>
											Terms
										</a>
									</li>

								</ul>
							</div>

						</div>
					</div>
				</footer>

			</div>
		</div>

		<script src="{{ asset('js/app.js') }}"></script>

		<script>
			document.addEventListener('DOMContentLoaded', function () {

				document.addEventListener('click', function (event) {
					const button = event.target.closest('.wacdo-flash-close');

					if (!button) {
						return;
					}

					const flash = button.closest('.wacdo-flash');

					if (flash) {
						flash.remove();
					}
				});

				if (window.feather) {
					window.feather.replace();
				}

				const forms = document.querySelectorAll(
					'form[data-live-validation="true"]'
				);

				const emailPattern =
					/^[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$/;

				function prepareFieldValidity(field) {
					if (field.type === 'email') {
						const value = field.value.trim();

						field.setCustomValidity('');

						if (value === '') {
							return;
						}

						if (!value.includes('@')) {
							field.setCustomValidity(
								"L'adresse email doit contenir un @."
							);

							return;
						}

						const parts = value.split('@');

						if (
							parts.length !== 2
							|| parts[0].trim() === ''
							|| parts[1].trim() === ''
						) {
							field.setCustomValidity(
								"Saisissez une adresse complète, par exemple utilisateur@wacdo.fr."
							);

							return;
						}

						if (!emailPattern.test(value)) {
							field.setCustomValidity(
								"L'adresse email doit contenir une extension valide comme .fr, .com ou .org."
							);
						}
					}
				}

				function validateField(field) {
					if (field.disabled || field.readOnly) {
						return;
					}

					prepareFieldValidity(field);
					field.reportValidity();
				}

				forms.forEach(function (form) {
					const fields = form.querySelectorAll(
						'input:not([type="hidden"]):not([type="submit"]):not([type="button"]), select, textarea'
					);

					fields.forEach(function (field) {
						let validationTimer;

						field.addEventListener('input', function () {
							clearTimeout(validationTimer);

							validationTimer = setTimeout(function () {
								validateField(field);
							}, 350);
						});

						field.addEventListener('change', function () {
							clearTimeout(validationTimer);
							validateField(field);
						});

						field.addEventListener('blur', function () {
							clearTimeout(validationTimer);
							validateField(field);
						});
					});

					form.addEventListener('submit', function () {
						fields.forEach(function (field) {
							prepareFieldValidity(field);
						});
					});
				});
			});

			window.addEventListener('pageshow', function (event) {
				if (event.persisted) {
					window.location.reload();
					return;
				}

				if (window.feather) {
					window.feather.replace();
				}
			});
		</script>

		{% block javascripts %}{% endblock %}
	</body>
</html>