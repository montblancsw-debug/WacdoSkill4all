{% extends 'base-backend.html.twig' %}

{% block title %}
    Modifier {{ produit.produitNom }} | Wacdo
{% endblock %}

{% block body %}
    {# Affiche le titre de modification. #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                Modifier le produit
            </h1>
            <p class="text-muted mb-0">
                {{ produit.produitNom }}
            </p>
        </div>
        {# Permet de supprimer le produit. #}
        {{ include('admin_produit/_delete_form.html.twig') }}
    </div>

    {# Affiche le formulaire de modification. #}
    {{ include('admin_produit/_form.html.twig', {
        'button_label': 'Mettre à jour'
    }) }}

    {# Retourne vers la liste des produits. #}
    <div class="mt-3">
        <a
            href="{{ path('app_admin_produit_index') }}"
            class="btn btn-secondary"
        >
            Retour à la liste
        </a>
    </div>
{% endblock %}