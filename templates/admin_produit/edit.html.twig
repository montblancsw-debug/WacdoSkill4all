{% extends 'base-backend.html.twig' %}

{% block title %}
	Modifier {{ produit.produitNom }} | Wacdo
{% endblock %}

{% block body %}

	<div class="mb-4">
		<h1 class="h3 mb-1">
			Modifier le produit
		</h1>

		<p class="text-muted mb-0">
			{{ produit.produitNom }}
		</p>
	</div>

	{{ include('admin_produit/_form.html.twig', {
		'button_label': 'Mettre à jour'
	}) }}

	<div class="mt-3">
		<a
			href="{{ path('app_admin_produit_index') }}"
			class="btn btn-secondary"
		>
			Retour à la liste
		</a>
	</div>

{% endblock %}