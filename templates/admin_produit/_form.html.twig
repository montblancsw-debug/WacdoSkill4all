{# Formulaire du CRUD Produit. #}

<div class="card">

	<div class="card-header">
		<h5 class="card-title mb-0">
			Informations du produit
		</h5>
	</div>

	{{ form_start(form, {
		'attr': {
			'id': 'admin-produit-form',
			'data-live-validation': 'true'
		}
	}) }}

	<div class="card-body">

		<div class="mb-3">
			{{ form_label(form.produit_nom) }}
			{{ form_widget(form.produit_nom) }}
			{{ form_errors(form.produit_nom) }}
		</div>

		<div class="mb-3">
			{{ form_label(form.produit_description) }}
			{{ form_widget(form.produit_description) }}
			{{ form_errors(form.produit_description) }}
		</div>

		<div class="mb-3">
			{{ form_label(form.produit_prix) }}
			{{ form_widget(form.produit_prix) }}
			{{ form_errors(form.produit_prix) }}
		</div>

		<div class="mb-3">
			{{ form_label(form.categorie) }}
			{{ form_widget(form.categorie) }}
			{{ form_errors(form.categorie) }}
		</div>

		<div class="mb-3">
			{{ form_label(form.imageFile) }}
			{{ form_widget(form.imageFile) }}
			{{ form_errors(form.imageFile) }}

			<div class="form-text">
				Formats acceptés : JPG, PNG ou WEBP. Taille maximale : 2 Mo.
			</div>

			{% if produit.produitImage %}
				<div class="mt-3">
					<img
						src="{{ asset('images/produits/' ~ produit.produitImage) }}"
						alt="{{ produit.produitNom }}"
						class="wacdo-edit-image-preview"
					>

					<div class="form-text">
						Image actuelle : {{ produit.produitImage }}
					</div>

					<div class="form-text">
						Laissez le champ vide pour conserver cette image.
					</div>
				</div>
			{% endif %}
		</div>

		<div class="mb-3">
			<div class="form-check">

				{{ form_widget(form.produit_stock) }}
				{{ form_label(form.produit_stock) }}
				{{ form_errors(form.produit_stock) }}

			</div>
		</div>

	</div>

	{{ form_end(form) }}

	<div class="card-footer d-flex align-items-center gap-2">

		<button
			type="submit"
			form="admin-produit-form"
			class="btn btn-primary"
		>
			{{ button_label|default('Enregistrer') }}
		</button>

		{% if produit.id %}
			{{ include('admin_produit/_delete_form.html.twig') }}
		{% endif %}

	</div>

</div>