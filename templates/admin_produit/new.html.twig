{% extends 'base-backend.html.twig' %}

{% block title %}
	Ajouter un produit | Wacdo
{% endblock %}

{% block body %}

	{# En-tête de la page. #}
	<div class="mb-4">
		<h1 class="h3 mb-1">
			Ajouter un produit
		</h1>

		<p class="text-muted mb-0">
			Créez un nouveau produit Wacdo.
		</p>
	</div>

	{# Formulaire de création. #}
	{{ include('admin_produit/_form.html.twig', {
		'button_label': 'Ajouter le produit'
	}) }}

	{# Retour à la liste des produits. #}
	<div class="mt-3">
		<a
			href="{{ path('app_admin_produit_index') }}"
			class="btn btn-secondary"
		>
			Retour à la liste
		</a>
	</div>

{% endblock %}