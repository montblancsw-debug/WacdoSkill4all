{% extends 'base-backend.html.twig' %}

{% block title %}
	{{ produit.produitNom }} | Wacdo
{% endblock %}

{% block body %}

	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>

			<h1 class="h3 mb-1">
				{{ produit.produitNom }}
			</h1>

			<p class="text-muted mb-0">
				Détail du produit
			</p>

		</div>

		<div>

			<a
				href="{{ path('app_admin_produit_edit', {'id': produit.id}) }}"
				class="btn btn-warning"
			>
				Modifier
			</a>

			{{ include('admin_produit/_delete_form.html.twig') }}

		</div>

	</div>

	<div class="card">

		<div class="card-header">

			<h5 class="card-title mb-0">
				Informations du produit
			</h5>

		</div>

		<div class="card-body">

			<table class="table align-middle">

				<tbody>

					<tr>
						<th style="width: 250px;">
							Identifiant
						</th>

						<td>
							{{ produit.id }}
						</td>
					</tr>

					<tr>
						<th>
							Nom
						</th>

						<td>
							{{ produit.produitNom }}
						</td>
					</tr>

					<tr>
						<th>
							Description
						</th>

						<td>

							{% if produit.produitDescription %}

								{{ produit.produitDescription|raw }}

							{% else %}

								<span class="text-muted">
									Aucune description
								</span>

							{% endif %}

						</td>
					</tr>

					<tr>
						<th>
							Prix
						</th>

						<td>
							{{ produit.produitPrix|number_format(2, ',', ' ') }}
							€
						</td>
					</tr>

					<tr>
						<th>
							Disponibilité
						</th>

						<td>

							{% if produit.produitStock %}

								<span class="badge bg-success">
									Disponible
								</span>

							{% else %}

								<span class="badge bg-danger">
									Indisponible
								</span>

							{% endif %}

						</td>
					</tr>

					<tr>
						<th>
							Catégorie
						</th>

						<td>

							{% if produit.categorie %}

								{{ produit.categorie.categorieNom }}

							{% else %}

								<span class="text-muted">
									Sans catégorie
								</span>

							{% endif %}

						</td>
					</tr>

					<tr>
						<th>
							Nom du fichier
						</th>

						<td>

							{% if produit.produitImage %}

								{{ produit.produitImage }}

							{% else %}

								<span class="text-muted">
									Non renseigné
								</span>

							{% endif %}

						</td>
					</tr>

					<tr>
						<th>
							Image
						</th>

						<td>

							{% if produit.produitImage %}

								<img
									src="{{ asset('images/produits/' ~ produit.produitImage) }}?v={{ produit.updatedAt ? produit.updatedAt|date('U') : '1' }}"
									alt="{{ produit.produitNom }}"
									class="img-fluid rounded"
									style="max-width: 300px; max-height: 300px;"
								>

							{% else %}

								<span class="text-muted">
									Aucune image
								</span>

							{% endif %}

						</td>
					</tr>

				</tbody>

			</table>

		</div>

	</div>

	<div class="mt-3">

		<a
			href="{{ path('app_admin_produit_index') }}"
			class="btn btn-secondary"
		>
			Retour à la liste
		</a>

	</div>

{% endblock %}