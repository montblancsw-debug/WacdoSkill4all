{% extends 'base-backend.html.twig' %}

{% block title %}
	Ajouter un menu | Wacdo
{% endblock %}

{% block body %}

	{# En-tête de la page. #}
	<div class="mb-4">
		<h1 class="h3 mb-1">
			Ajouter un menu
		</h1>

		<p class="text-muted mb-0">
			Créez un nouveau menu Wacdo.
		</p>
	</div>

	{# Formulaire de création. #}
	{{ include('admin_menu/_form.html.twig', {
		'button_label': 'Ajouter le menu'
	}) }}

	{# Retour à la liste des menus. #}
	<div class="mt-3">
		<a
			href="{{ path('app_admin_menu_index') }}"
			class="btn btn-secondary"
		>
			Retour à la liste
		</a>
	</div>

{% endblock %}