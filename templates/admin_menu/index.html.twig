{% extends 'base-backend.html.twig' %}
{% block title %}Gestion des menus | Wacdo{% endblock %}
{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Gestion des menus</h1>
            <p class="text-muted mb-0">Consultez et gérez les menus Wacdo.</p>
        </div>
        <a href="{{ path('app_admin_menu_new') }}" class="btn btn-primary">Ajouter un menu</a>
    </div>

    <div class="card">
        <div class="card-header"><h5 class="card-title mb-0">Liste des menus</h5></div>
        <div class="card-body">
            <form method="post" action="{{ path('app_admin_menu_index') }}" class="row g-2 mb-4">
                <div class="col-12 col-md">
                    <input type="text" name="search" class="form-control" placeholder="Rechercher un menu..." value="{{ search }}">
                </div>
                <div class="col-12 col-md-3">
                    <select name="status" class="form-select">
                        <option value="">Tous les statuts</option>
                        <option value="1" {% if status == '1' %}selected{% endif %}>Actif</option>
                        <option value="0" {% if status == '0' %}selected{% endif %}>Inactif</option>
                    </select>
                </div>
                <div class="col-12 col-md-auto"><button class="btn btn-primary w-100">Rechercher</button></div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>ID</th><th>Nom</th><th>Prix</th><th>Produits</th><th>Statut</th><th>Image</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    {% for menu in menus %}
                        <tr>
                            <td>{{ menu.id }}</td>
                            <td><strong>{{ menu.menuNom }}</strong></td>
                            <td>{{ menu.menuPrix|number_format(2, ',', ' ') }} €</td>
                            <td>{{ menu.produits|length }}</td>
                            <td>
                                {% if menu.menuStatus %}<span class="badge bg-success">Actif</span>
                                {% else %}<span class="badge bg-danger">Inactif</span>{% endif %}
                            </td>
                            <td>
                                {% if menu.menuImage %}
                                    <img src="{{ asset('images/menus/' ~ menu.menuImage) }}?v={{ menu.updatedAt ? menu.updatedAt|date('U') : '1' }}"
                                        alt="{{ menu.menuNom }}" class="img-fluid rounded" style="max-width:80px;max-height:80px;">
                                {% else %}<span class="text-muted">Aucune image</span>{% endif %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('app_admin_menu_show', {'id': menu.id}) }}" class="btn btn-info btn-sm">Voir</a>
                                <a href="{{ path('app_admin_menu_edit', {'id': menu.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                                {{ include('admin_menu/_delete_form.html.twig') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="text-center text-muted">Aucun menu trouvé.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}