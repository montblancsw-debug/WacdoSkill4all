{% extends 'base.html.twig' %}

{% block title %}Menu index{% endblock %}

{% block body %}
    <h1>Menu index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Menu_nom</th>
                <th>Menu_description</th>
                <th>Menu_prix</th>
                <th>Menu_status</th>
                <th>Menu_image</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for menu in menus %}
            <tr>
                <td>{{ menu.id }}</td>
                <td>{{ menu.menuNom }}</td>
                <td>{{ menu.menuDescription }}</td>
                <td>{{ menu.menuPrix }}</td>
                <td>{{ menu.menuStatus ? 'Yes' : 'No' }}</td>
                <td>{{ menu.menuImage }}</td>
                <td>
                    <a href="{{ path('app_admin_menu_show', {'id': menu.id}) }}">show</a>
                    <a href="{{ path('app_admin_menu_edit', {'id': menu.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_admin_menu_new') }}">Create new</a>
{% endblock %}
