{# Supprime le menu sélectionné. #}
<form
	method="post"
	action="{{ path('app_admin_menu_delete', {'id': menu.id}) }}"
	class="d-inline"
	onsubmit="return confirm('Voulez-vous vraiment supprimer ce menu ?');"
>
	<input
		type="hidden"
		name="_token"
		value="{{ csrf_token('delete' ~ menu.id) }}"
	>

	<button
		type="submit"
		class="btn btn-danger btn-sm"
	>
		Supprimer
	</button>
</form>