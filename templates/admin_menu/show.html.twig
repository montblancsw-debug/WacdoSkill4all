{% extends 'base-backend.html.twig' %}

{% block title %}
	{{ menu.menuNom }} | Wacdo
{% endblock %}

{% block body %}

	{# En-tête du menu. #}
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1 class="h3 mb-1">
				{{ menu.menuNom }}
			</h1>

			<p class="text-muted mb-0">
				Détail du menu
			</p>
		</div>

		<div>
			<a
				href="{{ path('app_admin_menu_edit', {'id': menu.id}) }}"
				class="btn btn-warning"
			>
				Modifier
			</a>

			{{ include('admin_menu/_delete_form.html.twig') }}
		</div>
	</div>

	{# Informations détaillées du menu. #}
	<div class="card">
		<div class="card-body">
			<table class="table align-middle">
				<tbody>

					<tr>
						<th>
							Identifiant
						</th>

						<td>
							{{ menu.id }}
						</td>
					</tr>

					<tr>
						<th>
							Nom
						</th>

						<td>
							{{ menu.menuNom }}
						</td>
					</tr>

					<tr>
						<th>
							Description
						</th>

						<td>
							{{ menu.menuDescription
								? menu.menuDescription|raw
								: 'Aucune description'
							}}
						</td>
					</tr>

					<tr>
						<th>
							Prix
						</th>

						<td>
							{{ menu.menuPrix|number_format(2, ',', ' ') }}
							€
						</td>
					</tr>

					<tr>
						<th>
							Statut
						</th>

						<td>
							{{ menu.menuStatus ? 'Actif' : 'Inactif' }}
						</td>
					</tr>

					<tr>
						<th>
							Produits
						</th>

						<td>
							{% for produit in menu.produits %}
								<span class="badge bg-secondary me-1">
									{{ produit.produitNom }}
								</span>
							{% endfor %}
						</td>
					</tr>

					<tr>
						<th>
							Image
						</th>

						<td>
							{% if menu.menuImage %}
								<img
									src="{{ asset('images/menus/' ~ menu.menuImage) }}"
									alt="{{ menu.menuNom }}"
									class="img-fluid rounded"
									style="max-width: 300px; max-height: 300px;"
								>
							{% else %}
								<span class="text-muted">
									Aucune image
								</span>
							{% endif %}
						</td>
					</tr>

				</tbody>
			</table>
		</div>
	</div>

	{# Retour à la liste des menus. #}
	<div class="mt-3">
		<a
			href="{{ path('app_admin_menu_index') }}"
			class="btn btn-secondary"
		>
			Retour à la liste
		</a>
	</div>

{% endblock %}