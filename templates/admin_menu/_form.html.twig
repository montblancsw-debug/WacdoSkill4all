{# Formulaire du CRUD Menu. #}

<div class="card">

    <div class="card-header">

        <h5 class="card-title mb-0">
            Informations du menu
        </h5>

    </div>

    {{ form_start(form, {
        'attr': {
            'id': 'admin-menu-form',
            'data-live-validation': 'true'
        }
    }) }}

    <div class="card-body">

        <div class="mb-3">

            {{ form_label(form.menu_nom) }}
            {{ form_widget(form.menu_nom) }}
            {{ form_errors(form.menu_nom) }}

        </div>

        <div class="mb-3">

            {{ form_label(form.menu_description) }}
            {{ form_widget(form.menu_description) }}
            {{ form_errors(form.menu_description) }}

        </div>

        <div class="mb-3">

            {{ form_label(form.menu_prix) }}
            {{ form_widget(form.menu_prix) }}
            {{ form_errors(form.menu_prix) }}

        </div>

        <div class="mb-3">

            {{ form_label(form.produits) }}

            <div class="row g-2 mb-3">

                <div class="col-12 col-md">

                    <input
                        type="text"
                        id="menu-product-search"
                        class="form-control"
                        placeholder="Rechercher un produit..."
                    >

                </div>

                <div class="col-12 col-md-4">

                    <select
                        id="menu-product-category"
                        class="form-select"
                    >

                        <option value="">
                            Toutes les catégories
                        </option>

                        {% for categorie in categories %}

                            <option value="{{ categorie.id }}">
                                {{ categorie.categorieNom }}
                            </option>

                        {% endfor %}

                    </select>

                </div>

            </div>

            <div class="mb-2">

                <strong>
                    Produits sélectionnés :
                    <span id="menu-product-count">
                        0
                    </span>
                </strong>

            </div>

            <div
                id="menu-product-list"
                class="border rounded p-3"
                style="max-height: 350px; overflow-y: auto;"
            >

                {% for produitField in form.produits %}

                    {% set produit = produitField.vars.choice.data %}

                    <div
                        class="form-check mb-2 menu-product-option"
                        data-name="{{ produit.produitNom|lower|e('html_attr') }}"
                        data-category="{{ produit.categorie ? produit.categorie.id : '' }}"
                    >

                        {{ form_widget(
                            produitField,
                            {
                                'attr': {
                                    'class': 'form-check-input menu-product-checkbox'
                                }
                            }
                        ) }}

                        {{ form_label(
                            produitField,
                            null,
                            {
                                'label_attr': {
                                    'class': 'form-check-label'
                                }
                            }
                        ) }}

                        {% if produit.categorie %}

                            <span class="text-muted small ms-2">
                                {{ produit.categorie.categorieNom }}
                            </span>

                        {% else %}

                            <span class="text-muted small ms-2">
                                Sans catégorie
                            </span>

                        {% endif %}

                        {% if not produit.produitStock %}

                            <span class="badge bg-danger ms-2">
                                Indisponible
                            </span>

                        {% endif %}

                    </div>

                {% else %}

                    <p class="text-muted mb-0">
                        Aucun produit disponible.
                    </p>

                {% endfor %}

            </div>

            {{ form_errors(form.produits) }}

            <div class="form-text">
                Cochez les produits un par un pour composer le menu.
                Les produits déjà cochés restent sélectionnés lorsque vous utilisez les filtres.
            </div>

        </div>

        <div class="mb-3">

            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile) }}
            {{ form_errors(form.imageFile) }}

            <div class="form-text">
                Formats acceptés : JPG, PNG ou WEBP.
                Taille maximale : 2 Mo.
            </div>

            {% if menu.menuImage %}

                <div class="mt-3">

                    <img
                        src="{{ asset('images/menus/' ~ menu.menuImage) }}?v={{ menu.updatedAt ? menu.updatedAt|date('U') : '1' }}"
                        alt="{{ menu.menuNom }}"
                        class="wacdo-edit-image-preview"
                    >

                    <div class="form-text">
                        Image actuelle : {{ menu.menuImage }}
                    </div>

                    <div class="form-text">
                        Laissez le champ vide pour conserver cette image.
                    </div>

                </div>

            {% endif %}

        </div>

        <div class="mb-3">

            <div class="form-check">

                {{ form_widget(form.menu_status) }}
                {{ form_label(form.menu_status) }}
                {{ form_errors(form.menu_status) }}

            </div>

        </div>

    </div>

    {{ form_end(form) }}

    <div class="card-footer d-flex align-items-center gap-2">

        <button
            type="submit"
            form="admin-menu-form"
            class="btn btn-primary"
        >
            {{ button_label|default('Enregistrer') }}
        </button>

        {% if menu.id %}

            {{ include('admin_menu/_delete_form.html.twig') }}

        {% endif %}

    </div>

</div>

<script>
document.addEventListener(
    'DOMContentLoaded',
    function () {

        const searchInput = document.getElementById(
            'menu-product-search'
        );

        const categorySelect = document.getElementById(
            'menu-product-category'
        );

        const options = document.querySelectorAll(
            '.menu-product-option'
        );

        const checkboxes = document.querySelectorAll(
            '.menu-product-checkbox'
        );

        const count = document.getElementById(
            'menu-product-count'
        );

        function updateCount() {

            let total = 0;

            checkboxes.forEach(
                function (checkbox) {

                    if (checkbox.checked) {
                        total++;
                    }

                }
            );

            if (count) {
                count.textContent = total;
            }
        }

        function filterProducts() {

            const search = searchInput
                ? searchInput.value
                    .trim()
                    .toLowerCase()
                : '';

            const category = categorySelect
                ? categorySelect.value
                : '';

            options.forEach(
                function (option) {

                    const name =
                        option.dataset.name || '';

                    const productCategory =
                        option.dataset.category || '';

                    const matchSearch =
                        search === ''
                        || name.includes(search);

                    const matchCategory =
                        category === ''
                        || productCategory === category;

                    option.style.display =
                        matchSearch && matchCategory
                            ? ''
                            : 'none';
                }
            );
        }

        if (searchInput) {
            searchInput.addEventListener(
                'input',
                filterProducts
            );
        }

        if (categorySelect) {
            categorySelect.addEventListener(
                'change',
                filterProducts
            );
        }

        checkboxes.forEach(
            function (checkbox) {

                checkbox.addEventListener(
                    'change',
                    updateCount
                );

            }
        );

        updateCount();
    }
);
</script>