<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Informations du menu</h5></div>

    {{ form_start(form, {'attr': {'id': 'admin-menu-form'}}) }}
    <div class="card-body">
        <div class="mb-3">{{ form_row(form.menu_nom) }}</div>
        <div class="mb-3">{{ form_row(form.menu_description) }}</div>
        <div class="mb-3">{{ form_row(form.menu_prix) }}</div>
        <div class="mb-3">{{ form_row(form.produits) }}</div>
        <div class="mb-3">
            {{ form_row(form.imageFile) }}
            <div class="form-text">Formats : JPG, PNG ou WEBP. Taille maximale : 2 Mo.</div>
            {% if menu.menuImage %}
                <div class="mt-3">
                    <img src="{{ asset('images/menus/' ~ menu.menuImage) }}?v={{ menu.updatedAt ? menu.updatedAt|date('U') : '1' }}"
                        alt="{{ menu.menuNom }}" class="wacdo-edit-image-preview">
                    <div class="form-text">Laissez le champ vide pour conserver l'image actuelle.</div>
                </div>
            {% endif %}
        </div>
        <div class="form-check">
            {{ form_widget(form.menu_status) }}
            {{ form_label(form.menu_status) }}
            {{ form_errors(form.menu_status) }}
        </div>
    </div>
    {{ form_end(form) }}

    <div class="card-footer">
        <button type="submit" form="admin-menu-form" class="btn btn-primary">
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
</div>