{% extends 'base-backend.html.twig' %}

{% block title %}
	Modifier {{ menu.menuNom }} | Wacdo
{% endblock %}

{% block body %}

	{# En-tête du menu à modifier. #}
	<div class="mb-4">
		<h1 class="h3 mb-1">
			Modifier le menu
		</h1>

		<p class="text-muted mb-0">
			{{ menu.menuNom }}
		</p>
	</div>

	{# Formulaire de modification. #}
	{{ include('admin_menu/_form.html.twig', {
		'button_label': 'Mettre à jour'
	}) }}

	{# Retour à la liste des menus. #}
	<div class="mt-3">
		<a
			href="{{ path('app_admin_menu_index') }}"
			class="btn btn-secondary"
		>
			Retour à la liste
		</a>
	</div>

{% endblock %}