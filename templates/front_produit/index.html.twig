{# Produits public des produits Wacdo. #}

{% extends 'base.html.twig' %}

{% block title %}
	Produits | Wacdo
{% endblock %}

{% block body %}

	<section class="front-section">

		<div class="mb-4">

			<h1 class="h2 mb-2">
				Nos Produits
			</h1>

			<p class="text-muted mb-0">
				Découvrez les produits proposés par Wacdo.
			</p>

		</div>

		{# Recherche un produit par son nom. #}
		<div class="card front-card mb-4">

			<div class="card-body">

				<form
					method="post"
					action="{{ path('app_front_produit') }}"
					class="row g-2"
				>

					<div class="col-12 col-md">

						<input
							type="text"
							name="search"
							class="form-control"
							placeholder="Rechercher un produit..."
							value="{{ search|default('') }}"
						>

					</div>

					<div class="col-12 col-md-auto">

						<button
							type="submit"
							class="btn btn-primary w-100"
						>
							Rechercher
						</button>

					</div>

				</form>

			</div>

		</div>

		<div class="row g-4">

			{% for produit in produits %}

				<div class="col-12 col-sm-6 col-lg-4">

					<div class="card front-card">

						{% if produit.produitImage %}

							<div class="front-product-image">

								<img
									src="{{ asset('images/produits/' ~ produit.produitImage) }}?v={{ produit.updatedAt ? produit.updatedAt|date('U') : '1' }}"
									class="card-img-top"
									alt="{{ produit.produitNom }}"
								>

							</div>

						{% else %}

							<div class="front-product-image front-product-image-empty">
								Aucune image
							</div>

						{% endif %}

						<div class="card-body d-flex flex-column">

							{% if produit.categorie %}

								<div class="mb-2">

									<span class="badge text-bg-secondary">
										{{ produit.categorie.categorieNom }}
									</span>

								</div>

							{% endif %}

							<h2 class="h5 card-title">
								{{ produit.produitNom }}
							</h2>

							{% if produit.produitDescription %}

								<p class="card-text text-muted">

									{{ produit.produitDescription|striptags|slice(0, 120) }}

									{% if produit.produitDescription|striptags|length > 120 %}
										...
									{% endif %}

								</p>

							{% else %}

								<p class="card-text text-muted">
									Aucune description.
								</p>

							{% endif %}

							<div class="mt-auto">

								<div class="d-flex justify-content-between align-items-center mb-3">

									<strong class="front-product-price">
										{{ produit.produitPrix|number_format(2, ',', ' ') }}
										€
									</strong>

									{% if produit.produitStock %}

										<span class="badge text-bg-success">
											Disponible
										</span>

									{% else %}

										<span class="badge text-bg-danger">
											Indisponible
										</span>

									{% endif %}

								</div>

								<div class="d-grid gap-2">

									<a
										href="{{ path('app_front_produit_detail', {'id': produit.id}) }}"
										class="btn btn-outline-primary"
									>
										Voir le produit
									</a>

									{% if produit.produitStock %}

										<form
											method="post"
											action="{{ path('app_front_panier_add', {'id': produit.id}) }}"
										>

											<input
												type="hidden"
												name="_token"
												value="{{ csrf_token('panier_add' ~ produit.id) }}"
											>

											<input
												type="hidden"
												name="quantite"
												value="1"
											>

											<button
												type="submit"
												class="btn btn-primary w-100"
											>
												Ajouter au panier
											</button>

										</form>

									{% else %}

										<button
											type="button"
											class="btn btn-secondary"
											disabled
										>
											Produit indisponible
										</button>

									{% endif %}

								</div>

							</div>

						</div>

					</div>

				</div>

			{% else %}

				<div class="col-12">

					<div class="alert alert-info mb-0">
						Aucun produit ne correspond à votre recherche.
					</div>

				</div>

			{% endfor %}

		</div>

	</section>

{% endblock %}