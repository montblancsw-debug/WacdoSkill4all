{# Détail public d'un produit Wacdo. #}

{% extends 'base.html.twig' %}

{% block title %}
	{{ produit.produitNom }} | Wacdo
{% endblock %}

{% block body %}

	<section class="front-section">

		<div class="mb-4">

			<a
				href="{{ path('app_front_produit') }}"
				class="btn btn-secondary"
			>
				Retour au Produits
			</a>

		</div>

		<div class="card front-card">

			<div class="card-body p-4">

				<div class="row g-5 align-items-start">

					<div class="col-12 col-lg-5">

						{% if produit.produitImage %}

							<div class="front-product-detail-image">

								<img
									src="{{ asset('images/produits/' ~ produit.produitImage) }}?v={{ produit.updatedAt ? produit.updatedAt|date('U') : '1' }}"
									alt="{{ produit.produitNom }}"
									class="img-fluid"
								>

							</div>

						{% else %}

							<div class="front-product-detail-image front-product-image-empty">
								Aucune image
							</div>

						{% endif %}

					</div>

					<div class="col-12 col-lg-7">

						{% if produit.categorie %}

							<div class="mb-3">

								<span class="badge text-bg-secondary">
									{{ produit.categorie.categorieNom }}
								</span>

							</div>

						{% endif %}

						<h1 class="display-6 fw-bold mb-3">
							{{ produit.produitNom }}
						</h1>

						<div class="d-flex align-items-center gap-3 mb-4">

							<strong class="front-product-detail-price">
								{{ produit.produitPrix|number_format(2, ',', ' ') }}
								€
							</strong>

							{% if produit.produitStock %}

								<span class="badge text-bg-success">
									Disponible
								</span>

							{% else %}

								<span class="badge text-bg-danger">
									Indisponible
								</span>

							{% endif %}

						</div>

						<div class="front-product-description mb-4">

							<h2 class="h5">
								Description
							</h2>

							{% if produit.produitDescription %}

								{{ produit.produitDescription|raw }}

							{% else %}

								<p class="text-muted">
									Aucune description pour ce produit.
								</p>

							{% endif %}

						</div>

						{% if produit.produitStock %}

							<form
								method="post"
								action="{{ path('app_front_panier_add', {'id': produit.id}) }}"
								class="front-add-cart-form"
							>

								<input
									type="hidden"
									name="_token"
									value="{{ csrf_token('panier_add' ~ produit.id) }}"
								>

								<div>

									<label
										for="produit-quantite"
										class="form-label"
									>
										Quantité
									</label>

									<input
										id="produit-quantite"
										type="number"
										name="quantite"
										class="form-control"
										value="1"
										min="1"
										max="99"
										required
									>

								</div>

								<button
									type="submit"
									class="btn btn-primary"
								>
									Ajouter au panier
								</button>

							</form>

						{% endif %}

					</div>

				</div>

			</div>

		</div>

	</section>

{% endblock %}