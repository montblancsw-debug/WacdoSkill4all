<!DOCTYPE html>

<html lang="fr">
{# ====================================================== #}
{# ======================== HEAD ========================= #}
{# ====================================================== #}

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}
				Wacdo
			{% endblock %}
		</title>

{# Charge Bootstrap pour la mise en forme du site. #}

		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

{# Charge les styles personnalisés du front-office. #}

		<link rel="stylesheet" href="{{ asset('css/front-wacdo.css') }}?v=20260822-1"> {# Le v- sert à éviter que le navigateur conserve une ancienne version du CSS en cache le code proviens de cloud panel #}
		{% block stylesheets %}
		{% endblock %}

		</head>
		<body
			class="d-flex flex-column min-vh-100">

{# ====================================================== #}
{# ===================== NAVIGATION ===================== #}
{# ====================================================== #}

			{{ include('inc/_front-top-nav.html.twig') }}

{# ====================================================== #}
{# ================= CONTENU PRINCIPAL ================== #}
{# ====================================================== #}

			<main class="front-main flex-grow-1">
				<div
					class="container py-4">

{# Affiche les messages de confirmation, d'erreur ou d'information. #}

					{% for label, messages in app.flashes %}
						{% for message in messages %}

							<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
								{{ message }}
								<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
							</div>

						{% endfor %}
					{% endfor %}
					{% block body %}
					{% endblock %}
				</div>
			</main>

{# ====================================================== #}
{# ==================== PIED DE PAGE ==================== #}
{# ====================================================== #}

			{{ include('inc/_front-footer.html.twig') }}

{# Charge les composants JavaScript de Bootstrap. #}

			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

			{% block javascripts %}
			{% endblock %}
		</body>
	</html>
