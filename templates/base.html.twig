<!DOCTYPE html>

<html lang="fr">

	<head>

		<meta charset="UTF-8">

		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			{% block title %}
				Wacdo
			{% endblock %}
		</title>


		{# Charge Bootstrap pour le front-office. #}
		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">


		{# Charge les styles propres au front Wacdo. #}
		<link rel="stylesheet" href="{{ asset('css/front-wacdo.css') }}"> {% block stylesheets %}{% endblock %}

		</head>


		<body
			class="d-flex flex-column min-vh-100">


			{# Affiche la navigation du site. #}
			{{ include('inc/_front-top-nav.html.twig') }}


			{# Affiche le contenu principal. #}
			<main class="front-main flex-grow-1">

				<div
					class="container py-4">


					{# Affiche les messages Flash Symfony. #}
					{% for label, messages in app.flashes %}

						{% for message in messages %}

							<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">

								{{ message }}

								<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>

							</div>

						{% endfor %}

					{% endfor %}


					{% block body %}{% endblock %}

				</div>

			</main>


			{# Affiche le pied de page. #}
			{{ include('inc/_front-footer.html.twig') }}


			{# Charge le JavaScript Bootstrap. #}
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>


			{% block javascripts %}{% endblock %}

		</body>

	</html>
