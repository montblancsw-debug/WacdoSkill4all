{# Page d'accueil du front-office Wacdo. #}

{% extends 'base.html.twig' %}

{% block title %}
	Bienvenue chez Wacdo
{% endblock %}

{% block body %}

	<section class="front-hero mb-5">

		<div class="row align-items-center">

			<div class="col-12 col-lg-8">

				<h1 class="front-hero-title mb-3">
					Bienvenue chez Wacdo
				</h1>

				<p class="lead text-muted mb-4">
					Découvrez notre catalogue et préparez votre prochaine commande.
				</p>

				<a
					href="{{ path('app_front_categorie') }}"
					class="btn btn-primary btn-lg"
				>
					Découvrir le catalogue
				</a>

				{% if not app.user %}

					<a
						href="{{ path('app_login') }}"
						class="btn btn-secondary btn-lg ms-2"
					>
						Connexion
					</a>

				{% endif %}

			</div>

		</div>

	</section>

	<section class="front-section">

		<div class="mb-4">

			<h2 class="h3">
				Notre catalogue
			</h2>

			<p class="text-muted">
				Retrouvez les produits disponibles chez Wacdo.
			</p>

		</div>

		<div class="row g-4">

			<div class="col-12 col-md-4">

				<div class="card front-card">

					<div class="card-body d-flex flex-column">

						<h3 class="h5">
							Catégories
						</h3>

						<p class="text-muted">
							Les produits Wacdo sont organisés par catégorie.
						</p>

						<div class="mt-auto">

							<a
								href="{{ path('app_front_categorie') }}"
								class="btn btn-outline-primary"
							>
								Voir les catégories
							</a>

						</div>

					</div>

				</div>

			</div>

			<div class="col-12 col-md-4">

				<div class="card front-card">

					<div class="card-body d-flex flex-column">

						<h3 class="h5">
							Produits
						</h3>

						<p class="text-muted">
							Consultez tous les produits proposés par Wacdo.
						</p>

						<div class="mt-auto">

							<a
								href="{{ path('app_front_produit') }}"
								class="btn btn-outline-primary"
							>
								Voir le catalogue
							</a>

						</div>

					</div>

				</div>

			</div>

			<div class="col-12 col-md-4">

				<div class="card front-card">

					<div class="card-body d-flex flex-column">

						<h3 class="h5">
							Commandes
						</h3>

						{% if is_granted('ROLE_USER') %}

							<p class="text-muted">
								Consultez l'historique et le statut de vos commandes.
							</p>

							<div class="mt-auto">

								<a
									href="{{ path('app_front_commande') }}"
									class="btn btn-outline-primary"
								>
									Mes commandes
								</a>

							</div>

						{% elseif not app.user %}

							<p class="text-muted">
								Connectez-vous pour passer et suivre vos commandes.
							</p>

							<div class="mt-auto">

								<a
									href="{{ path('app_login') }}"
									class="btn btn-outline-primary"
								>
									Se connecter
								</a>

							</div>

						{% else %}

							<p class="text-muted mb-0">
								Le suivi des commandes clients est accessible depuis le dashboard.
							</p>

						{% endif %}

					</div>

				</div>

			</div>

		</div>

	</section>

{% endblock %}